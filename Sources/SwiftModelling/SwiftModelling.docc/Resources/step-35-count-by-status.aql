let fullTime = self.employees->select(e | e.status = company::EmploymentStatus::FULL_TIME)->size() in
let partTime = self.employees->select(e | e.status = company::EmploymentStatus::PART_TIME)->size() in
let contractors = self.employees->select(e | e.status = company::EmploymentStatus::CONTRACTOR)->size() in
'Full-time: ' + fullTime.toString() + ', part-time: ' + partTime.toString() + ', contractors: ' + contractors.toString()
