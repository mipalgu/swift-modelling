[comment encoding = UTF-8 /]
[module GenerateSwiftClasses('http://www.example.org/reporting')]

[comment Generates a Swift API for a sales report, with its figures as data. /]
[template public generateSwiftAPI(report : SalesReport)]
[comment @main /]
[file ('SalesReportAPI.swift', false, 'UTF-8')]
// Generated by GenerateSwiftClasses.mtl from the sales report of [report.shopName/].
// Do not edit: change the model and generate the file again.

/// The sales figures of one product category.
public struct CategoryMetricAPI: Codable, Equatable, Sendable {
    public let categoryName: String
    public let productCount: Int
    public let unitsSold: Int
    public let totalSales: Double
    public let avgProductPrice: Double

    public init(categoryName: String, productCount: Int, unitsSold: Int, totalSales: Double, avgProductPrice: Double) {
        self.categoryName = categoryName
        self.productCount = productCount
        self.unitsSold = unitsSold
        self.totalSales = totalSales
        self.avgProductPrice = avgProductPrice
    }
}

/// The purchases of one customer.
public struct CustomerMetricAPI: Codable, Equatable, Sendable {
    public let customerName: String
    public let email: String
    public let orderCount: Int
    public let totalSpent: Double
    public let avgOrderValue: Double

    public init(customerName: String, email: String, orderCount: Int, totalSpent: Double, avgOrderValue: Double) {
        self.customerName = customerName
        self.email = email
        self.orderCount = orderCount
        self.totalSpent = totalSpent
        self.avgOrderValue = avgOrderValue
    }
}

/// The sales and stock of one product.
public struct ProductMetricAPI: Codable, Equatable, Sendable {
    public let sku: String
    public let productName: String
    public let categoryName: String
    public let unitsSold: Int
    public let revenue: Double
    public let stock: Int

    public init(sku: String, productName: String, categoryName: String, unitsSold: Int, revenue: Double, stock: Int) {
        self.sku = sku
        self.productName = productName
        self.categoryName = categoryName
        self.unitsSold = unitsSold
        self.revenue = revenue
        self.stock = stock
    }
}

/// A sales report with its key figures and the metrics it is made of.
public struct SalesReportAPI: Codable, Equatable, Sendable {
    public let shopName: String
    public let totalRevenue: Double
    public let totalOrders: Int
    public let totalUnits: Int
    public let categoryMetrics: ['['/]CategoryMetricAPI]
    public let customerMetrics: ['['/]CustomerMetricAPI]
    public let productMetrics: ['['/]ProductMetricAPI]

    public init(shopName: String, totalRevenue: Double, totalOrders: Int, totalUnits: Int,
                categoryMetrics: ['['/]CategoryMetricAPI], customerMetrics: ['['/]CustomerMetricAPI],
                productMetrics: ['['/]ProductMetricAPI]) {
        self.shopName = shopName
        self.totalRevenue = totalRevenue
        self.totalOrders = totalOrders
        self.totalUnits = totalUnits
        self.categoryMetrics = categoryMetrics
        self.customerMetrics = customerMetrics
        self.productMetrics = productMetrics
    }

    /// The average value of an order, or zero without orders.
    public var averageOrderValue: Double {
        totalOrders > 0 ? totalRevenue / Double(totalOrders) : 0
    }

    /// The category with the highest sales.
    public func topCategory() -> CategoryMetricAPI? {
        categoryMetrics.max { $0.totalSales < $1.totalSales }
    }

    /// The customer who spent the most.
    public func topCustomer() -> CustomerMetricAPI? {
        customerMetrics.max { $0.totalSpent < $1.totalSpent }
    }

    /// The products that are out of stock.
    public func outOfStockProducts() -> ['['/]ProductMetricAPI] {
        productMetrics.filter { $0.stock == 0 }
    }

    /// Whether the category sales, the customer spending and the product revenue
    /// all add up to the total revenue.
    public func isConsistent() -> Bool {
        let categories = categoryMetrics.reduce(0) { $0 + $1.totalSales }
        let customers = customerMetrics.reduce(0) { $0 + $1.totalSpent }
        let products = productMetrics.reduce(0) { $0 + $1.revenue }
        return categories == totalRevenue && customers == totalRevenue && products == totalRevenue
    }
}

extension SalesReportAPI {
    /// The sales report of [report.shopName/], as generated from the model.
    public static let generated = SalesReportAPI(
        shopName: "[report.shopName/]",
        totalRevenue: [report.totalRevenue/],
        totalOrders: [report.totalOrders/],
        totalUnits: [report.totalUnits/],
        categoryMetrics: ['['/]
[for (m : CategoryMetric | report.categoryMetrics)]
            CategoryMetricAPI(categoryName: "[m.categoryName/]", productCount: [m.productCount/], unitsSold: [m.unitsSold/], totalSales: [m.totalSales/], avgProductPrice: [m.avgProductPrice/]),
[/for]
        ],
        customerMetrics: ['['/]
[for (m : CustomerMetric | report.customerMetrics)]
            CustomerMetricAPI(customerName: "[m.customerName/]", email: "[m.email/]", orderCount: [m.orderCount/], totalSpent: [m.totalSpent/], avgOrderValue: [m.avgOrderValue/]),
[/for]
        ],
        productMetrics: ['['/]
[for (m : ProductMetric | report.productMetrics)]
            ProductMetricAPI(sku: "[m.sku/]", productName: "[m.productName/]", categoryName: "[m.categoryName/]", unitsSold: [m.unitsSold/], revenue: [m.revenue/], stock: [m.stock/]),
[/for]
        ]
    )
}
[/file]
[/template]
