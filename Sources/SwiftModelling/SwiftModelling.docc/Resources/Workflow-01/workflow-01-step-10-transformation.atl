-- Transforms the operational data of a shop into a sales report.
module ECommerce2Reporting;
create OUT : Reporting from IN : Shop;

-- The order items of all orders of the shop.
helper context Shop!Shop def: allItems : Sequence(Shop!OrderItem) =
	self.orders->collect(o | o.items)->flatten();

-- The value of an order item: quantity times unit price.
helper context Shop!OrderItem def: value : Real =
	self.quantity * self.unitPrice;

-- The total value of an order.
helper context Shop!Order def: total : Real =
	self.items->collect(i | i.value)->sum();

-- The order items that sold this product.
helper context Shop!Product def: soldItems : Sequence(Shop!OrderItem) =
	Shop!OrderItem.allInstances()->select(i | i.product = self);

-- The units of this product that were sold.
helper context Shop!Product def: unitsSold : Integer =
	self.soldItems->collect(i | i.quantity)->sum();

-- The revenue of this product.
helper context Shop!Product def: revenue : Real =
	self.soldItems->collect(i | i.value)->sum();

-- The whole shop becomes one sales report.
rule Shop2SalesReport {
	from
		s : Shop!Shop
	to
		report : Reporting!SalesReport (
			shopName <- s.name,
			totalRevenue <- s.allItems->collect(i | i.value)->sum(),
			totalOrders <- s.orders->size(),
			totalUnits <- s.allItems->collect(i | i.quantity)->sum(),
			categoryMetrics <- s.categories,
			customerMetrics <- s.customers,
			productMetrics <- s.products
		)
}

-- Each category becomes a category metric.
rule Category2CategoryMetric {
	from
		c : Shop!Category
	to
		metric : Reporting!CategoryMetric (
			categoryName <- c.name,
			productCount <- c.products->size(),
			unitsSold <- c.products->collect(p | p.unitsSold)->sum(),
			totalSales <- c.products->collect(p | p.revenue)->sum(),
			avgProductPrice <- if c.products->isEmpty() then 0.0
				else c.products->collect(p | p.price)->sum() / c.products->size() endif
		)
}

-- Each customer becomes a customer metric.
rule Customer2CustomerMetric {
	from
		c : Shop!Customer
	to
		metric : Reporting!CustomerMetric (
			customerName <- c.name,
			email <- c.email,
			orderCount <- c.orders->size(),
			totalSpent <- c.orders->collect(o | o.total)->sum(),
			avgOrderValue <- if c.orders->isEmpty() then 0.0
				else c.orders->collect(o | o.total)->sum() / c.orders->size() endif
		)
}

-- Each product becomes a product metric.
rule Product2ProductMetric {
	from
		p : Shop!Product
	to
		metric : Reporting!ProductMetric (
			sku <- p.sku,
			productName <- p.name,
			categoryName <- p.category.name,
			unitsSold <- p.unitsSold,
			revenue <- p.revenue,
			stock <- p.stock
		)
}
