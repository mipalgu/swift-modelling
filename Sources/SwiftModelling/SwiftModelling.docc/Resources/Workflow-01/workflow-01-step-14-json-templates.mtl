[comment encoding = UTF-8 /]
[module GenerateJSONAPI('http://www.example.org/reporting')]

[comment Generates a JSON schema for sales reports and the report itself as JSON data. /]
[template public generateJSON(report : SalesReport)]
[comment @main /]
[file ('sales-report.schema.json', false, 'UTF-8')]
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sales report",
  "type": "object",
  "required": ['['/]"shopName", "totalRevenue", "totalOrders", "totalUnits"],
  "properties": {
    "shopName": { "type": "string" },
    "totalRevenue": { "type": "number", "minimum": 0 },
    "totalOrders": { "type": "integer", "minimum": 0 },
    "totalUnits": { "type": "integer", "minimum": 0 },
    "categoryMetrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "categoryName": { "type": "string" },
          "productCount": { "type": "integer" },
          "unitsSold": { "type": "integer" },
          "totalSales": { "type": "number" },
          "avgProductPrice": { "type": "number" }
        }
      }
    },
    "customerMetrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "customerName": { "type": "string" },
          "email": { "type": "string" },
          "orderCount": { "type": "integer" },
          "totalSpent": { "type": "number" },
          "avgOrderValue": { "type": "number" }
        }
      }
    },
    "productMetrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku": { "type": "string" },
          "productName": { "type": "string" },
          "categoryName": { "type": "string" },
          "unitsSold": { "type": "integer" },
          "revenue": { "type": "number" },
          "stock": { "type": "integer" }
        }
      }
    }
  }
}
[/file]
[file ('sales-report.json', false, 'UTF-8')]
{
  "shopName": "[report.shopName/]",
  "totalRevenue": [report.totalRevenue/],
  "totalOrders": [report.totalOrders/],
  "totalUnits": [report.totalUnits/],
  "categoryMetrics": ['['/]
[for (m : CategoryMetric | report.categoryMetrics) separator(',\n')]
    { "categoryName": "[m.categoryName/]", "productCount": [m.productCount/], "unitsSold": [m.unitsSold/], "totalSales": [m.totalSales/], "avgProductPrice": [m.avgProductPrice/] }[/for]
  ],
  "customerMetrics": ['['/]
[for (m : CustomerMetric | report.customerMetrics) separator(',\n')]
    { "customerName": "[m.customerName/]", "email": "[m.email/]", "orderCount": [m.orderCount/], "totalSpent": [m.totalSpent/], "avgOrderValue": [m.avgOrderValue/] }[/for]
  ],
  "productMetrics": ['['/]
[for (m : ProductMetric | report.productMetrics) separator(',\n')]
    { "sku": "[m.sku/]", "productName": "[m.productName/]", "categoryName": "[m.categoryName/]", "unitsSold": [m.unitsSold/], "revenue": [m.revenue/], "stock": [m.stock/] }[/for]
  ]
}
[/file]
[/template]
