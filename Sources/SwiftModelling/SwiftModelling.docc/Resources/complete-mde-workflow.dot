digraph CompleteMDEWorkflow {
    bgcolor="white"
    fontname="Arial"
    rankdir=LR
    node [shape=box, style=rounded, fontname="Arial", fontsize=12]
    edge [fontname="Arial", fontsize=10]

    subgraph cluster_define {
        label="1. Define"
        style=rounded
        bgcolor="#e8f4f8"
        ecore [label="ECommerce.ecore\n(OCL invariants)" shape=note]
    }

    subgraph cluster_create {
        label="2. Create and check"
        style=rounded
        bgcolor="#f8f4e8"
        xmi [label="shop-data.xmi\ntest-instances/" shape=box3d]
        check [label="swift-ecore validate\nswift-aql query" shape=ellipse]
    }

    subgraph cluster_transform {
        label="3. Transform"
        style=rounded
        bgcolor="#e8f8f5"
        atl [label="ECommerce2Reporting.atl" shape=ellipse]
        report [label="sales-report.xmi\n(Reporting.ecore)" shape=box3d]
    }

    subgraph cluster_generate {
        label="4. Generate"
        style=rounded
        bgcolor="#f4e8f8"
        mtl [label="MTL templates" shape=ellipse]
        swift [label="SalesReportAPI.swift" shape=note]
        json [label="JSON schema\nand data" shape=note]
        docs [label="sales-report.md" shape=note]
    }

    subgraph cluster_integrate {
        label="5. Integrate"
        style=rounded
        bgcolor="#fff8e8"
        build [label="Swift package\nswift build, tests" shape=ellipse]
        e2e [label="End-to-end checks\nfigures, diff, checksums" shape=ellipse]
    }

    ecore -> xmi [label="instantiate"]
    xmi -> check
    xmi -> atl [label="source"]
    atl -> report [label="target"]
    report -> mtl
    mtl -> swift
    mtl -> json
    mtl -> docs
    swift -> build
    json -> build
    docs -> e2e
    build -> e2e

    legendTitle [label="Complete MDE pipeline" shape=plaintext fontname="Arial Bold" fontsize=14]
}
