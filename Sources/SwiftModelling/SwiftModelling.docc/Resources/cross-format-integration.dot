digraph CrossFormatIntegration {
    bgcolor="white"
    rankdir=LR
    node [shape=box, style=rounded, fontname="Arial", fontsize=12]
    edge [fontname="Arial", fontsize=10]

    metamodel [label="ProjectManagement.ecore\n(shared metamodel)" shape=box3d fillcolor="#e8f4f8" style=filled]

    subgraph cluster_formats {
        label="Formats"
        style=rounded
        bgcolor="#f8f8f8"

        xmi [label="XMI\n(desktop tool)" shape=box3d fillcolor="#f8f4e8" style=filled]
        json [label="JSON\n(web editor)" shape=box3d fillcolor="#e8f8f5" style=filled]
        view [label="ProjectAPI view\n(web dashboard)" shape=box3d fillcolor="#e8f8f5" style=filled]
        swift [label="Swift types\nand APIs" shape=note fillcolor="#f4e8f8" style=filled]
    }

    xmi -> json [label="swift-ecore convert"]
    json -> xmi [label="swift-ecore convert"]
    json -> view [label="swift-atl\nProjectToAPI"]
    json -> json [label="swift-atl --refining\nReconcileProject"]
    metamodel -> swift [label="swift-mtl generate"]
    json -> swift [label="JSONDecoder" style=dotted]
    metamodel -> xmi [label="validate, compare" style=dashed]
    metamodel -> json [label="validate, compare" style=dashed]
}
