digraph LegacyModelAnalysis {
    bgcolor="white"
    fontname="Arial"
    rankdir=TB
    node [shape=box, style=rounded, fontname="Arial", fontsize=12]
    edge [fontname="Arial", fontsize=10]

    subgraph cluster_legacy {
        label="Legacy system"
        style=rounded
        bgcolor="#f8f4e8"

        metamodel [label="LegacyOrders.ecore" shape=note]
        data [label="orders-2024-01.xmi" shape=box3d]
    }

    subgraph cluster_analysis {
        label="Analysis"
        style=rounded
        bgcolor="#e8f4f8"

        validate [label="swift-ecore validate\n(does it load?)" shape=ellipse]
        measure [label="swift-ecore statistics, inspect\n(where is the structure overloaded?)" shape=ellipse]
        query [label="swift-aql query\n(which data is inconsistent?)" shape=ellipse]
    }

    subgraph cluster_output {
        label="Findings"
        style=rounded
        bgcolor="#e8f8f5"

        structure [label="Order with 14 attributes,\nfree-text status, code strings" shape=note]
        quality [label="Mixed-case statuses, repeated customers,\nunlinked product codes, wrong totals" shape=note]
        plan [label="refactoring-plan.md" shape=note]
    }

    metamodel -> validate
    data -> validate
    validate -> measure
    validate -> query
    measure -> structure
    query -> quality
    structure -> plan
    quality -> plan
}
