digraph ModelRefactoringPipeline {
    bgcolor="white"
    fontname="Arial"
    rankdir=LR
    node [shape=box, style=rounded, fontname="Arial", fontsize=12]
    edge [fontname="Arial", fontsize=10]

    subgraph cluster_input {
        label="Version 1.0"
        style=rounded
        bgcolor="#f8f4e8"
        legacy [label="Legacy exports\nlegacy/*.xmi" shape=box3d]
        legacyMM [label="LegacyOrders.ecore" shape=note]
    }

    subgraph cluster_pipeline {
        label="Refactoring pipeline"
        style=rounded
        bgcolor="#e8f4f8"

        clean [label="Clean\nCleanLegacyOrders.atl\n(refining)" shape=ellipse]
        migrate [label="Migrate\nLegacyOrders2Orders.atl" shape=ellipse]
        validate [label="Validate\nOCL invariants,\nobject counts" shape=ellipse]
        qa [label="Quality assurance\nAQL checks,\nJSON round trip" shape=ellipse]
    }

    subgraph cluster_output {
        label="Version 2.0"
        style=rounded
        bgcolor="#e8f8f5"
        improvedMM [label="Orders.ecore" shape=note]
        release [label="Release\nmodels + SHA256SUMS" shape=box3d]
    }

    backup [label="Backup with\nchecksums (rollback)" shape=cylinder]
    compat [label="Legacy-format exports\nOrders2LegacyOrders.atl" shape=box3d]

    legacy -> clean -> migrate -> validate -> qa -> release
    legacyMM -> clean [style=dashed]
    improvedMM -> validate [style=dashed]
    legacy -> backup [style=dashed label="before release"]
    qa -> compat [style=dashed label="tools on 1.0"]
}
