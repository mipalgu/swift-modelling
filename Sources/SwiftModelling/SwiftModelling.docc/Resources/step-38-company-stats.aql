let total = self.employees->size() in
let fullTime = self.employees->select(e | e.status = company::EmploymentStatus::FULL_TIME)->size() in
let percentage = if total > 0 then (fullTime * 100) / total else 0 endif in
'Employees: ' + total.toString() + ', full-time: ' + fullTime.toString() + ' (' + percentage.toString() + '%)'
