-- @path Project=/Project/Project.ecore
-- @path Report=/Report/Report.ecore

module ProjectHighlights;
create OUT: Report from IN: Project;

-- Lazy rule: every call creates a new summary
lazy rule TaskSummary {
    from
        s: Project!Task
    to
        t: Report!Summary (
            title <- s.name,
            status <- if s.completed then 'Done' else 'Pending' endif
        )
}

-- Matched rule that calls the lazy rule twice for each high-priority task:
-- once for the summaries and once for the highlights
rule ProjectToDocument {
    from
        s: Project!Project
    to
        t: Report!Document (
            name <- s.name,
            summaries <- s.tasks->collect(task | thisModule.TaskSummary(task)),
            highlights <- s.tasks
                ->select(task | task.priority > 5)
                ->collect(task | thisModule.TaskSummary(task))
        )
}
