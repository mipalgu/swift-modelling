-- @path Project=/Project/Project.ecore
-- @path Report=/Report/Report.ecore

module ProjectTransform;
create OUT: Report from IN: Project;

-- Rule with do block for imperative operations
rule ProjectReport {
    from
        s: Project!Project
    using {
        completedCount : Integer = s.tasks->select(task | task.completed)->size();
        totalCount : Integer = s.tasks->size();
    }
    to
        t: Report!Document (
            name <- s.name
        )
    do {
        -- Imperative code: calculate completion percentage
        if (totalCount > 0) {
            t.completionRate <- (completedCount * 100) div totalCount;
        } else {
            t.completionRate <- 0;
        }
    }
}
