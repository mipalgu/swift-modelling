<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:src="http://www.example.org/optimisation/source">
  <src:Container name="Backlog">
    <elements name="Login page" active="true" priority="8"/>
    <elements name="Search" active="true" priority="3"/>
