<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns="http://www.example.org/organisation">
  <!-- Sample Company: two departments, three teams, five employees -->
  <Company name="Harbour Logistics">
    <departments name="Operations">
      <teams name="Dispatch">
        <members name="Ayesha Rahman" role="Coordinator"/>
        <members name="Tom Nguyen" role="Planner"/>
      </teams>
      <teams name="Fleet">
        <members name="Maria Rossi" role="Mechanic"/>
      </teams>
    </departments>
    <departments name="Finance">
      <teams name="Payroll">
        <members name="Kofi Mensah" role="Analyst"/>
        <members name="Lena Fischbach" role="Manager"/>
      </teams>
    </departments>
  </Company>
</xmi:XMI>
