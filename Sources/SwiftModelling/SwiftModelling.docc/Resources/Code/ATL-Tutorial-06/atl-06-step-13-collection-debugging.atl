-- @path Source=/Source/Source.ecore
-- @path Target=/Target/Target.ecore

module DebugExample;
create OUT: Target from IN: Source;

-- Trace an intermediate collection to check what it holds
helper context Source!Container def: verifiedChildren: Sequence(Source!Element) =
    self.children
        ->select(c | not c.name.oclIsUndefined())
        ->debug('children with a name');
