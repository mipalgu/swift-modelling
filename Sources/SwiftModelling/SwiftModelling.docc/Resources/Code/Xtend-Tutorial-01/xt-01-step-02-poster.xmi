<?xml version="1.0" encoding="UTF-8"?>
<shapes:Drawing xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:shapes="http://www.example.org/shapes" name="poster" width="200" height="120">
  <shapes xsi:type="shapes:Rectangle" name="frame" colour="navy" x="0" y="0" width="200" height="120"/>
  <shapes xsi:type="shapes:Circle" name="sun" colour="gold" x="150" y="40" radius="25"/>
  <shapes xsi:type="shapes:Rectangle" name="door" x="40" y="60" width="30" height="60"/>
</shapes:Drawing>
