-- @path Model=/Model/Model.ecore

module RefiningExample;
create OUT: Model refining IN: Model;

-- Matched rule that refines each container and calls the lazy rule
rule SummariseContainer {
    from
        s: Model!Container
    to
        t: Model!Container (
            summaries <- s.elements->collect(e | thisModule.CreateSummary(e))
        )
}

-- Lazy rule in refining mode
lazy rule CreateSummary {
    from
        s: Model!Element
    to
        t: Model!Summary (
            elementName <- s.name
        )
}
