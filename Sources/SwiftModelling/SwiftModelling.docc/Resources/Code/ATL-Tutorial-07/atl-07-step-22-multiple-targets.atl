-- @path Source=/Source/Source.ecore
-- @path TargetA=/TargetA/TargetA.ecore
-- @path TargetB=/TargetB/TargetB.ecore

module MultiTargetExample;
create OUTA: TargetA, OUTB: TargetB from IN: Source;

-- Create one element in each target model from the same source element
rule ToTargets {
    from
        s: Source!Element
    to
        a: TargetA!ItemA (
            name <- s.name
        ),
        b: TargetB!ItemB (
            title <- s.name
        )
}
