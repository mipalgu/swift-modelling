<?xml version="1.0" encoding="UTF-8"?>
<!-- Project data as an EMF-based desktop planning tool saves it. -->
<!-- References use EMF fragment paths such as #//@members.0 (the first team member). -->
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:pm="http://www.example.org/projectmanagement/1.0">

  <pm:Organisation name="Example Software Co" domain="example.com">
    <!-- Departments: //@departments.0 to //@departments.2 -->
    <departments id="DEPT-ENG" name="Engineering" code="ENG">
      <manager href="#//@members.0"/>
    </departments>
    <departments id="DEPT-DESIGN" name="Design" code="DES">
      <manager href="#//@members.2"/>
    </departments>
    <departments id="DEPT-QA" name="Quality Assurance" code="QA">
      <manager href="#//@members.4"/>
    </departments>

    <!-- Team members: //@members.0 to //@members.5 -->
    <members id="MEMBER-001" name="Alice Chen" email="alice.chen@example.com" role="Engineering Lead">
      <department href="#//@departments.0"/>
    </members>
    <members id="MEMBER-002" name="Bob Williams" email="bob.williams@example.com" role="Senior Developer">
      <department href="#//@departments.0"/>
    </members>
    <members id="MEMBER-003" name="Carol Thompson" email="carol.thompson@example.com" role="Design Lead">
      <department href="#//@departments.1"/>
    </members>
    <members id="MEMBER-004" name="David Kim" email="david.kim@example.com" role="UX Designer">
      <department href="#//@departments.1"/>
    </members>
    <members id="MEMBER-005" name="Emma Wilson" email="emma.wilson@example.com" role="QA Lead">
      <department href="#//@departments.2"/>
    </members>
    <members id="MEMBER-006" name="Frank Brown" email="frank.brown@example.com" role="Test Engineer">
      <department href="#//@departments.2"/>
    </members>

    <!-- Projects -->
    <projects id="PROJ-001" name="Customer Portal Redesign"
        description="Modernise the customer portal with improved usability and performance"
        status="ACTIVE" startDate="2026-01-12" targetEndDate="2026-06-30" budget="250000.0">
      <owner href="#//@members.0"/>
      <department href="#//@departments.0"/>
      <teamMembers href="#//@members.0"/>
      <teamMembers href="#//@members.1"/>
      <teamMembers href="#//@members.2"/>
      <teamMembers href="#//@members.3"/>

      <milestones id="MS-001" name="Design Phase Complete" dueDate="2026-02-27" completed="true">
        <deliverables href="#//@projects.0/@tasks.0"/>
        <deliverables href="#//@projects.0/@tasks.1"/>
      </milestones>
      <milestones id="MS-002" name="Backend API Ready" dueDate="2026-04-10" completed="false">
        <deliverables href="#//@projects.0/@tasks.2"/>
        <deliverables href="#//@projects.0/@tasks.3"/>
      </milestones>
      <milestones id="MS-003" name="Beta Release" dueDate="2026-05-29" completed="false">
        <deliverables href="#//@projects.0/@tasks.4"/>
      </milestones>

      <tasks id="TASK-001" title="Create wireframes"
          description="Design wireframes for all major user flows"
          priority="HIGH" status="COMPLETED" estimatedHours="40.0" actualHours="45.0" dueDate="2026-02-06">
        <assignee href="#//@members.3"/>
        <comments id="CMT-001" text="Wireframes approved by the product owner" timestamp="2026-02-05T14:30:00Z">
          <author href="#//@members.3"/>
        </comments>
      </tasks>
      <tasks id="TASK-002" title="Design system components"
          description="Create a reusable component library based on the wireframes"
          priority="HIGH" status="COMPLETED" estimatedHours="60.0" actualHours="55.0" dueDate="2026-02-27">
        <assignee href="#//@members.2"/>
        <dependencies href="#//@projects.0/@tasks.0"/>
      </tasks>
      <tasks id="TASK-003" title="Implement authentication API"
          description="Build the sign-in endpoints with multi-factor authentication"
          priority="CRITICAL" status="IN_PROGRESS" estimatedHours="80.0" actualHours="35.0" dueDate="2026-03-20">
        <assignee href="#//@members.1"/>
        <comments id="CMT-002" text="Sign-in flow works, starting on multi-factor support" timestamp="2026-03-02T10:15:00Z">
          <author href="#//@members.1"/>
        </comments>
      </tasks>
      <tasks id="TASK-004" title="Implement customer data API"
          description="Endpoints for customer profiles and preferences"
          priority="HIGH" status="NOT_STARTED" estimatedHours="60.0" dueDate="2026-04-03">
        <assignee href="#//@members.1"/>
        <dependencies href="#//@projects.0/@tasks.2"/>
      </tasks>
      <tasks id="TASK-005" title="Frontend implementation"
          description="Build the portal frontend with the design system components"
          priority="HIGH" status="NOT_STARTED" estimatedHours="120.0" dueDate="2026-05-15">
        <assignee href="#//@members.0"/>
        <dependencies href="#//@projects.0/@tasks.1"/>
        <dependencies href="#//@projects.0/@tasks.2"/>
        <dependencies href="#//@projects.0/@tasks.3"/>
      </tasks>
    </projects>

    <projects id="PROJ-002" name="Mobile Test Automation"
        description="Automated testing for the mobile applications"
        status="PLANNING" startDate="2026-03-02" targetEndDate="2026-08-28" budget="150000.0">
      <owner href="#//@members.4"/>
      <department href="#//@departments.2"/>
      <teamMembers href="#//@members.4"/>
      <teamMembers href="#//@members.5"/>

      <milestones id="MS-004" name="Framework Architecture" dueDate="2026-03-31" completed="false">
        <deliverables href="#//@projects.1/@tasks.0"/>
      </milestones>

      <tasks id="TASK-006" title="Design test framework architecture"
          description="Define the architecture for cross-platform test automation"
          priority="HIGH" status="NOT_STARTED" estimatedHours="40.0" dueDate="2026-03-20">
        <assignee href="#//@members.4"/>
      </tasks>
      <tasks id="TASK-007" title="Evaluate testing tools"
          description="Compare the candidate user interface testing tools"
          priority="MEDIUM" status="NOT_STARTED" estimatedHours="24.0" dueDate="2026-03-27">
        <assignee href="#//@members.5"/>
      </tasks>
    </projects>
  </pm:Organisation>
</xmi:XMI>
