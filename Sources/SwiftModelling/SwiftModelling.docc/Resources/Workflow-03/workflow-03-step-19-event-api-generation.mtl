[comment encoding = UTF-8 /]
[comment]
  Generates typed change events for real-time synchronisation and an event
  bus that delivers them to every subscriber. The events carry the data
  transfer objects of the generated DTOs.swift and encode to JSON, so any
  transport, such as a WebSocket or a message queue, can carry them.
[/comment]
[module GenerateEventAPI('http://www.eclipse.org/emf/2002/Ecore')]

[template public generate(pkg : EPackage)]
[file (pkg.name + 'Events.swift', false, 'UTF-8')]
// [pkg.name/]Events.swift
// Generated from [pkg.name/].ecore by GenerateEventAPI.mtl; regenerate instead of editing.

import Foundation

/// What happened to an object.
public enum ChangeKind: String, Codable, Sendable {
    case created
    case updated
    case deleted
}

/// A change to one object of a [pkg.name/] model.
///
/// Each case names the class of the changed object and carries its new
/// state; a deleted object carries its last state.
public enum ModelEvent: Codable, Sendable {
[for (cls : EClass | resources(pkg))]
    /// A change to a [cls.name/].
    case [cls.name.toLowerFirst()/](ChangeKind, [cls.name/]DTO)
[/for]

    /// The kind of the change.
    public var kind: ChangeKind {
        switch self {
[for (cls : EClass | resources(pkg))]
        case .[cls.name.toLowerFirst()/](let kind, _): kind
[/for]
        }
    }

    /// The identifier of the changed object.
    public var objectID: String? {
        switch self {
[for (cls : EClass | resources(pkg))]
        case .[cls.name.toLowerFirst()/](_, let object): object.[idName(cls)/]
[/for]
        }
    }
}

/// A model event with the client that sent it and its sequence number.
public struct EventEnvelope: Codable, Sendable {
    /// The client that published the event.
    public var source: String
    /// The position of the event in the stream of its source.
    public var sequence: Int
    /// The event.
    public var event: ModelEvent

    /// Creates an envelope.
    public init(source: String, sequence: Int, event: ModelEvent) {
        self.source = source
        self.sequence = sequence
        self.event = event
    }

    /// Encodes the envelope as JSON for a transport.
    public func jsonData() throws -> Data {
        try JSONEncoder().encode(self)
    }

    /// Decodes an envelope that a transport delivered.
    public init(jsonData: Data) throws {
        self = try JSONDecoder().decode(EventEnvelope.self, from: jsonData)
    }
}

/// Delivers the events that clients publish to every subscriber.
public actor ModelEventBus {
    private var subscribers: ['['/]UUID: AsyncStream<EventEnvelope>.Continuation[']'/] = ['['/]:[']'/]
    private var sequence = 0

    /// Creates an event bus without subscribers.
    public init() {}

    /// Returns a stream of all events published from now on.
    public func subscribe() -> AsyncStream<EventEnvelope> {
        let id = UUID()
        let (stream, continuation) = AsyncStream<EventEnvelope>.makeStream()
        continuation.onTermination = { _ in
            Task { await self.unsubscribe(id) }
        }
        subscribers['['/]id[']'/] = continuation
        return stream
    }

    /// Publishes an event to every subscriber.
    ///
    /// - Parameters:
    ///   - event: The event to publish.
    ///   - source: The client that publishes it.
    /// - Returns: The envelope that the subscribers receive.
    @discardableResult
    public func publish(_ event: ModelEvent, from source: String) -> EventEnvelope {
        sequence += 1
        let envelope = EventEnvelope(source: source, sequence: sequence, event: event)
        for continuation in subscribers.values {
            continuation.yield(envelope)
        }
        return envelope
    }

    private func unsubscribe(_ id: UUID) {
        subscribers['['/]id[']'/] = nil
    }
}
[/file]
[/template]

[comment The classes that are REST resources: those with an identifier. /]
[query private resources(pkg : EPackage) : Sequence(EClass) =
    pkg.eClassifiers->filter(EClass)->select(c | c.eAllAttributes->exists(a | a.iD))->asSequence()
/]

[comment The name of the identifier attribute of a class. /]
[query private idName(cls : EClass) : String =
    cls.eAllAttributes->select(a | a.iD)->asSequence()->first().name
/]
