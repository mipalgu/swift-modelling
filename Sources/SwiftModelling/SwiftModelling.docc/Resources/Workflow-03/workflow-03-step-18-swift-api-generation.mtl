[comment encoding = UTF-8 /]
[comment]
  Generates a Swift client for the REST interface of GenerateRestAPI.mtl.
  The client uses the data transfer objects of the generated DTOs.swift
  and URLSession, so it runs wherever Foundation does.
[/comment]
[module GenerateSwiftAPI('http://www.eclipse.org/emf/2002/Ecore')]

[template public generate(pkg : EPackage)]
[file (pkg.name + 'Client.swift', false, 'UTF-8')]
// [pkg.name/]Client.swift
// Generated from [pkg.name/].ecore by GenerateSwiftAPI.mtl; regenerate instead of editing.

import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

/// An error that a request to the [pkg.name/] API reports.
public enum APIError: Error, Sendable {
    /// The response was not an HTTP response.
    case invalidResponse
    /// The server answered with a status code outside 200 to 299.
    case httpStatus(Int)
}

/// A client for the [pkg.name/] REST API.
///
/// Every resource of the API has list, get, create, update and delete
/// operations; the export operations return the whole model.
public actor [pkg.name/]Client {
    /// The base URL of the API, such as https://api.example.com/v1.
    public let baseURL: URL

    /// The bearer token sent with every request, if any.
    public var bearerToken: String?

    private let session: URLSession
    private let encoder = JSONEncoder()
    private let decoder = JSONDecoder()

    /// Creates a client.
    ///
    /// - Parameters:
    ///   - baseURL: The base URL of the API.
    ///   - bearerToken: The bearer token to send, if any.
    ///   - session: The URL session that performs the requests.
    public init(baseURL: URL, bearerToken: String? = nil, session: URLSession = .shared) {
        self.baseURL = baseURL
        self.bearerToken = bearerToken
        self.session = session
    }
[for (cls : EClass | resources(pkg))]

[operations(cls)/]
[/for]

    // MARK: - Synchronisation and export

    /// Fetches the synchronisation status.
    public func syncStatus() async throws -> SyncStatusDTO {
        try await decode(send("GET", "sync/status"))
    }

    /// Pushes local changes to the server.
    public func push(_ changes: ChangeSetDTO) async throws -> PushResultDTO {
        try await decode(send("POST", "sync/push", body: encoder.encode(changes)))
    }

    /// Exports the model as XMI.
    public func exportXMI() async throws -> Data {
        try await send("GET", "export/xmi")
    }

    /// Exports the model in the JSON format of swift-ecore convert.
    public func exportJSON() async throws -> Data {
        try await send("GET", "export/json")
    }

    // MARK: - Requests

    private func send(_ method: String, _ path: String, query: ['['/]URLQueryItem[']'/] = ['['/][']'/], body: Data? = nil) async throws -> Data {
        var components = URLComponents(url: baseURL.appendingPathComponent(path), resolvingAgainstBaseURL: false)
        if !query.isEmpty {
            components?.queryItems = query
        }
        guard let url = components?.url else {
            throw URLError(.badURL)
        }
        var request = URLRequest(url: url)
        request.httpMethod = method
        if let body {
            request.httpBody = body
            request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        }
        if let bearerToken {
            request.setValue("Bearer \(bearerToken)", forHTTPHeaderField: "Authorization")
        }
        let (data, response) = try await session.data(for: request)
        guard let http = response as? HTTPURLResponse else {
            throw APIError.invalidResponse
        }
        guard (200..<300).contains(http.statusCode) else {
            throw APIError.httpStatus(http.statusCode)
        }
        return data
    }

    private func decode<T: Decodable>(_ data: Data) throws -> T {
        try decoder.decode(T.self, from: data)
    }
}
[/file]
[/template]

[comment The classes that are REST resources: those with an identifier. /]
[query private resources(pkg : EPackage) : Sequence(EClass) =
    pkg.eClassifiers->filter(EClass)->select(c | c.eAllAttributes->exists(a | a.iD))->asSequence()
/]

[template private operations(cls : EClass)]
    // MARK: - [cls.name/]

    /// Lists [cls.name/] objects, a page at a time.
    public func list[cls.name/]s(limit: Int = 20, offset: Int = 0) async throws -> Page<[cls.name/]DTO> {
        let query = ['['/]URLQueryItem(name: "limit", value: String(limit)), URLQueryItem(name: "offset", value: String(offset))[']'/]
        return try await decode(send("GET", "[cls.name.toLower()/]s", query: query))
    }

    /// Fetches the [cls.name/] with an identifier.
    public func get[cls.name/](id: String) async throws -> [cls.name/]DTO {
        try await decode(send("GET", "[cls.name.toLower()/]s/\(id)"))
    }

    /// Creates a [cls.name/].
    public func create[cls.name/](_ input: [cls.name/]InputDTO) async throws -> [cls.name/]DTO {
        try await decode(send("POST", "[cls.name.toLower()/]s", body: encoder.encode(input)))
    }

    /// Updates the [cls.name/] with an identifier.
    public func update[cls.name/](id: String, _ input: [cls.name/]InputDTO) async throws -> [cls.name/]DTO {
        try await decode(send("PUT", "[cls.name.toLower()/]s/\(id)", body: encoder.encode(input)))
    }

    /// Deletes the [cls.name/] with an identifier.
    public func delete[cls.name/](id: String) async throws {
        _ = try await send("DELETE", "[cls.name.toLower()/]s/\(id)")
    }
[/template]
