[comment encoding = UTF-8 /]
[comment]
  Generates a REST interface from an Ecore metamodel:
  - openapi.yaml: an OpenAPI 3 description of the interface,
  - DTOs.swift: the data transfer objects, using Foundation only, so that
    servers, clients and event handlers can share them,
  - routes.swift: route stubs for a Vapor 4 server that delegate to
    service protocols, which the server implements.
  Every class with an identifier attribute becomes a resource. References
  between objects become identifiers, and contained objects are nested.
  The [ and ] of the generated text are written as ['['/] and [']'/],
  because a bare [ starts an MTL tag.
[/comment]
[module GenerateRestAPI('http://www.eclipse.org/emf/2002/Ecore')]

[template public generate(pkg : EPackage)]
[file ('openapi.yaml', false, 'UTF-8')]
[generateOpenAPISpec(pkg)/]
[/file]
[file ('DTOs.swift', false, 'UTF-8')]
[generateDTOs(pkg)/]
[/file]
[file ('routes.swift', false, 'UTF-8')]
[generateServerRoutes(pkg)/]
[/file]
[/template]

[comment The classes that become REST resources: those with an identifier. /]
[query private resources(pkg : EPackage) : Sequence(EClass) =
    pkg.eClassifiers->filter(EClass)->select(c | c.eAllAttributes->exists(a | a.iD))->asSequence()
/]

[comment The root class: the first class that no containment reference holds. /]
[query private rootClass(pkg : EPackage) : EClass =
    pkg.eClassifiers->filter(EClass)->select(c |
        not pkg.eClassifiers->filter(EClass)->exists(o |
            o.eReferences->exists(r | r.containment and r.eType = c)))->asSequence()->first()
/]

[comment Generate the OpenAPI 3.0 specification /]
[template private generateOpenAPISpec(pkg : EPackage)]
# OpenAPI specification for the [pkg.name/] API
# Generated from [pkg.name/].ecore by GenerateRestAPI.mtl; regenerate instead of editing.

openapi: "3.0.3"
info:
  title: [pkg.name/] API
  description: REST API for [pkg.name/] models
  version: "1.0.0"

servers:
  - url: https://api.example.com/v1
    description: Example server

paths:
[for (cls : EClass | resources(pkg))]
[generatePathsForClass(cls)/]
[/for]
  /sync/status:
    get:
      summary: Get the synchronisation status
      operationId: getSyncStatus
      tags: ['['/]Synchronisation[']'/]
      responses:
        '200':
          description: Current synchronisation status
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SyncStatus'

  /sync/push:
    post:
      summary: Push local changes
      operationId: pushChanges
      tags: ['['/]Synchronisation[']'/]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChangeSet'
      responses:
        '200':
          description: Changes pushed successfully
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PushResult'
        '409':
          description: Conflict detected
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ConflictReport'

  /sync/pull:
    get:
      summary: Pull remote changes
      operationId: pullChanges
      tags: ['['/]Synchronisation[']'/]
      parameters:
        - name: since
          in: query
          description: Time of the last synchronisation
          schema:
            type: string
            format: date-time
      responses:
        '200':
          description: Remote changes
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ChangeSet'

  /export/xmi:
    get:
      summary: Export the model as XMI
      operationId: exportXMI
      tags: ['['/]Export[']'/]
      responses:
        '200':
          description: The model in XMI
          content:
            application/xml:
              schema:
                type: string

  /export/json:
    get:
      summary: Export the model as JSON
      operationId: exportJSON
      tags: ['['/]Export[']'/]
      responses:
        '200':
          description: The model in the JSON format of swift-ecore convert (root class [rootClass(pkg).name/])
          content:
            application/json:
              schema:
                type: object

components:
  schemas:
[for (cls : EClass | pkg.eClassifiers->filter(EClass))]
[generateSchemaForClass(cls)/]
[/for]
[for (enum : EEnum | pkg.eClassifiers->filter(EEnum))]
[generateSchemaForEnum(enum)/]
[/for]
    SyncStatus:
      type: object
      properties:
        lastSync:
          type: string
          format: date-time
        pendingChanges:
          type: integer
        conflicts:
          type: integer
        status:
          type: string
          enum: ['['/]SYNCED, PENDING, CONFLICT[']'/]

    ChangeSet:
      type: object
      properties:
        timestamp:
          type: string
          format: date-time
        source:
          type: string
        changes:
          type: array
          items:
            $ref: '#/components/schemas/Change'

    Change:
      type: object
      properties:
        id:
          type: string
        type:
          type: string
          enum: ['['/]ADD, UPDATE, DELETE[']'/]
        elementType:
          type: string
        elementId:
          type: string
        properties:
          type: object
          additionalProperties: true

    PushResult:
      type: object
      properties:
        success:
          type: boolean
        changesApplied:
          type: integer
        newVersion:
          type: string

    ConflictReport:
      type: object
      properties:
        conflicts:
          type: array
          items:
            $ref: '#/components/schemas/Conflict'

    Conflict:
      type: object
      properties:
        elementId:
          type: string
        elementType:
          type: string
        localChange:
          $ref: '#/components/schemas/Change'
        remoteChange:
          $ref: '#/components/schemas/Change'

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer

security:
  - bearerAuth: ['['/][']'/]
[/template]

[comment Generate the paths of a resource class /]
[template private generatePathsForClass(cls : EClass)]
  /[cls.name.toLower()/]s:
    get:
      summary: List [cls.name/] objects
      operationId: list[cls.name/]s
      tags: ['['/][cls.name/][']'/]
      parameters:
        - name: limit
          in: query
          schema:
            type: integer
            default: 20
        - name: offset
          in: query
          schema:
            type: integer
            default: 0
      responses:
        '200':
          description: A page of [cls.name/] objects
          content:
            application/json:
              schema:
                type: object
                properties:
                  items:
                    type: array
                    items:
                      $ref: '#/components/schemas/[cls.name/]'
                  total:
                    type: integer
    post:
      summary: Create a [cls.name/]
      operationId: create[cls.name/]
      tags: ['['/][cls.name/][']'/]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/[cls.name/]Input'
      responses:
        '201':
          description: [cls.name/] created
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/[cls.name/]'

  /[cls.name.toLower()/]s/{id}:
    get:
      summary: Get a [cls.name/] by its identifier
      operationId: get[cls.name/]
      tags: ['['/][cls.name/][']'/]
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: The [cls.name/]
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/[cls.name/]'
        '404':
          description: No [cls.name/] has this identifier
    put:
      summary: Update a [cls.name/]
      operationId: update[cls.name/]
      tags: ['['/][cls.name/][']'/]
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/[cls.name/]Input'
      responses:
        '200':
          description: [cls.name/] updated
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/[cls.name/]'
    delete:
      summary: Delete a [cls.name/]
      operationId: delete[cls.name/]
      tags: ['['/][cls.name/][']'/]
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      responses:
        '204':
          description: [cls.name/] deleted

[/template]

[comment Generate the schemas of a class /]
[template private generateSchemaForClass(cls : EClass)]
    [cls.name/]:
      type: object
      properties:
[for (attr : EAttribute | cls.eAllAttributes)]
        [attr.name/]:
          [attr.openAPIType()/]
[/for]
[for (ref : EReference | cls.eAllReferences->select(r | not r.containment))]
        [ref.name/]Id[if (ref.upperBound <> 1)]s[/if]:
          [ref.openAPIRefType()/]
[/for]
[for (ref : EReference | cls.eAllReferences->select(r | r.containment))]
        [ref.name/]:
          [ref.openAPIContainmentType()/]
[/for]

[if (cls.eAllAttributes->exists(a | a.iD))]
    [cls.name/]Input:
      type: object
      properties:
[for (attr : EAttribute | cls.eAllAttributes->reject(a | a.iD))]
        [attr.name/]:
          [attr.openAPIType()/]
[/for]
[for (ref : EReference | cls.eAllReferences->select(r | not r.containment))]
        [ref.name/]Id[if (ref.upperBound <> 1)]s[/if]:
          [ref.openAPIRefType()/]
[/for]

[/if]
[/template]

[comment Generate the schema of an enumeration /]
[template private generateSchemaForEnum(enum : EEnum)]
    [enum.name/]:
      type: string
      enum:
[for (literal : EEnumLiteral | enum.eLiterals)]
        - [literal.name/]
[/for]

[/template]

[comment Map an attribute to an OpenAPI type; continuation lines take the indentation of the calling line /]
[query private openAPIType(attr : EAttribute) : String =
    if attr.eType.name = 'EString' then 'type: string'
    else if attr.eType.name = 'EInt' then 'type: integer'
    else if attr.eType.name = 'EDouble' then 'type: number\nformat: double'
    else if attr.eType.name = 'EBoolean' then 'type: boolean'
    else if attr.eType.oclIsKindOf(EEnum) then '$ref: \'#/components/schemas/' + attr.eType.name + '\''
    else 'type: string'
    endif endif endif endif endif
/]

[comment Map a reference to an OpenAPI type of identifiers /]
[query private openAPIRefType(ref : EReference) : String =
    if ref.upperBound = 1 then 'type: string'
    else 'type: array\nitems:\n  type: string'
    endif
/]

[comment Map a containment reference to an OpenAPI type /]
[query private openAPIContainmentType(ref : EReference) : String =
    if ref.upperBound = 1 then '$ref: \'#/components/schemas/' + ref.eType.name + '\''
    else 'type: array\nitems:\n  $ref: \'#/components/schemas/' + ref.eType.name + '\''
    endif
/]

[comment Generate the data transfer objects /]
[template private generateDTOs(pkg : EPackage)]
// DTOs.swift
// Generated from [pkg.name/].ecore by GenerateRestAPI.mtl; regenerate instead of editing.
// Data transfer objects of the [pkg.name/] API, shared by servers and clients.

import Foundation
[for (enum : EEnum | pkg.eClassifiers->filter(EEnum))]

/// The [enum.name/] values of [pkg.name/].
public enum [enum.name/]: String, Codable, CaseIterable, Sendable {
[for (literal : EEnumLiteral | enum.eLiterals)]
    case [caseName(literal.name)/] = "[literal.name/]"
[/for]
}
[/for]
[for (cls : EClass | pkg.eClassifiers->filter(EClass))]

[generateDTOForClass(cls)/]
[/for]

// MARK: - Synchronisation

/// The synchronisation status of the server.
public struct SyncStatusDTO: Codable, Sendable {
    public var lastSync: Date?
    public var pendingChanges: Int
    public var conflicts: Int
    public var status: SyncState
}

/// The state of the synchronisation.
public enum SyncState: String, Codable, Sendable {
    case synced = "SYNCED"
    case pending = "PENDING"
    case conflict = "CONFLICT"
}

/// Changes that one client sends or receives.
public struct ChangeSetDTO: Codable, Sendable {
    public var timestamp: Date
    public var source: String
    public var changes: ['['/]ChangeDTO[']'/]

    public init(timestamp: Date, source: String, changes: ['['/]ChangeDTO[']'/]) {
        self.timestamp = timestamp
        self.source = source
        self.changes = changes
    }
}

/// One change of one object.
public struct ChangeDTO: Codable, Sendable {
    public var id: String
    public var type: ChangeType
    public var elementType: String
    public var elementId: String
    public var properties: ['['/]String: PropertyValue[']'/]

    public init(id: String, type: ChangeType, elementType: String, elementId: String, properties: ['['/]String: PropertyValue[']'/]) {
        self.id = id
        self.type = type
        self.elementType = elementType
        self.elementId = elementId
        self.properties = properties
    }
}

/// The kind of a change.
public enum ChangeType: String, Codable, Sendable {
    case add = "ADD"
    case update = "UPDATE"
    case delete = "DELETE"
}

/// The result of pushing changes.
public struct PushResultDTO: Codable, Sendable {
    public var success: Bool
    public var changesApplied: Int
    public var newVersion: String
}

/// The conflicts that prevented a push.
public struct ConflictReportDTO: Codable, Sendable {
    public var conflicts: ['['/]ConflictDTO[']'/]
}

/// Two changes of the same object that cannot both be applied.
public struct ConflictDTO: Codable, Sendable {
    public var elementId: String
    public var elementType: String
    public var localChange: ChangeDTO
    public var remoteChange: ChangeDTO
}

// MARK: - Pagination

/// A page of a list of objects.
public struct Page<T: Codable & Sendable>: Codable, Sendable {
    public var items: ['['/]T[']'/]
    public var total: Int

    public init(items: ['['/]T[']'/], total: Int) {
        self.items = items
        self.total = total
    }
}

// MARK: - Property values

/// The value of a changed property.
public enum PropertyValue: Codable, Sendable, Equatable {
    case string(String)
    case int(Int)
    case double(Double)
    case bool(Bool)

    public init(from decoder: any Decoder) throws {
        let container = try decoder.singleValueContainer()
        if let bool = try? container.decode(Bool.self) {
            self = .bool(bool)
        } else if let int = try? container.decode(Int.self) {
            self = .int(int)
        } else if let double = try? container.decode(Double.self) {
            self = .double(double)
        } else {
            self = .string(try container.decode(String.self))
        }
    }

    public func encode(to encoder: any Encoder) throws {
        var container = encoder.singleValueContainer()
        switch self {
        case .string(let value): try container.encode(value)
        case .int(let value): try container.encode(value)
        case .double(let value): try container.encode(value)
        case .bool(let value): try container.encode(value)
        }
    }
}
[/template]

[comment Generate the data transfer objects of a class /]
[template private generateDTOForClass(cls : EClass)]
// MARK: - [cls.name/]

/// The transfer form of a [cls.name/].
public struct [cls.name/]DTO: Codable, Sendable[if (cls.eAllAttributes->exists(a | a.iD))], Identifiable[/if] {
[for (attr : EAttribute | cls.eAllAttributes)]
    public var [attr.name/]: [attr.swiftDTOType()/]
[/for]
[for (ref : EReference | cls.eAllReferences->select(r | not r.containment))]
    public var [ref.name/]Id[if (ref.upperBound <> 1)]s[/if]: [ref.swiftRefDTOType()/]
[/for]
[for (ref : EReference | cls.eAllReferences->select(r | r.containment))]
    public var [ref.name/]: [ref.swiftContainmentDTOType()/]
[/for]
}
[if (cls.eAllAttributes->exists(a | a.iD))]

/// The values that create or update a [cls.name/].
public struct [cls.name/]InputDTO: Codable, Sendable {
[for (attr : EAttribute | cls.eAllAttributes->reject(a | a.iD))]
    public var [attr.name/]: [attr.swiftDTOType()/]
[/for]
[for (ref : EReference | cls.eAllReferences->select(r | not r.containment))]
    public var [ref.name/]Id[if (ref.upperBound <> 1)]s[/if]: [ref.swiftRefDTOType()/]
[/for]
}
[/if]
[/template]

[comment Converts a literal name such as NOT_STARTED to notStarted. /]
[template private caseName(name : String)][for (word : String | name.toLower().tokenize('_'))][if (i = 1)][word/][else][word.toUpperFirst()/][/if][/for][/template]

[comment Map an attribute to a Swift type /]
[query private swiftDTOType(attr : EAttribute) : String =
    let base : String =
        if attr.eType.name = 'EInt' then 'Int'
        else if attr.eType.name = 'EDouble' then 'Double'
        else if attr.eType.name = 'EBoolean' then 'Bool'
        else if attr.eType.oclIsKindOf(EEnum) then attr.eType.name
        else 'String'
        endif endif endif endif in
    if attr.upperBound <> 1 then '[' + base + ']'
    else if attr.lowerBound > 0 then base else base + '?' endif
    endif
/]

[comment Map a reference to the Swift type of identifiers /]
[query private swiftRefDTOType(ref : EReference) : String =
    if ref.upperBound <> 1 then '[String]'
    else if ref.lowerBound > 0 then 'String' else 'String?' endif
    endif
/]

[comment Map a containment reference to a Swift type /]
[query private swiftContainmentDTOType(ref : EReference) : String =
    if ref.upperBound <> 1 then '[' + ref.eType.name + 'DTO]'
    else if ref.lowerBound > 0 then ref.eType.name + 'DTO' else ref.eType.name + 'DTO?' endif
    endif
/]

[comment Generate the Vapor route stubs /]
[template private generateServerRoutes(pkg : EPackage)]
// routes.swift
// Generated from [pkg.name/].ecore by GenerateRestAPI.mtl; regenerate instead of editing.
// Route stubs for a Vapor 4 server. The server implements the service
// protocols below and passes its services to configureRoutes.

import Vapor
[for (cls : EClass | pkg.eClassifiers->filter(EClass))]

extension [cls.name/]DTO: Content {}
[if (cls.eAllAttributes->exists(a | a.iD))]
extension [cls.name/]InputDTO: Content {}
[/if]
[/for]

extension Page: Content, RequestDecodable, ResponseEncodable, AsyncRequestDecodable, AsyncResponseEncodable where T: Content {}
extension SyncStatusDTO: Content {}
extension ChangeSetDTO: Content {}
extension PushResultDTO: Content {}
[for (cls : EClass | resources(pkg))]

/// The operations behind the [cls.name/] routes.
protocol [cls.name/]Service: Sendable {
    func list(limit: Int, offset: Int) async throws -> Page<[cls.name/]DTO>
    func find(id: String) async throws -> [cls.name/]DTO?
    func create(_ input: [cls.name/]InputDTO) async throws -> [cls.name/]DTO
    func update(id: String, input: [cls.name/]InputDTO) async throws -> [cls.name/]DTO
    func delete(id: String) async throws
}
[/for]

/// The synchronisation and export operations.
protocol SyncService: Sendable {
    func status() async throws -> SyncStatusDTO
    func push(_ changes: ChangeSetDTO) async throws -> PushResultDTO
    func pull(since: String?) async throws -> ChangeSetDTO
    func exportXMI() async throws -> String
    func exportJSON() async throws -> String
}

/// Registers all routes of the [pkg.name/] API below /v1.
func configureRoutes(
    _ app: Application,
[for (cls : EClass | resources(pkg))]
    [cls.name.toLowerFirst()/]Service: some [cls.name/]Service,
[/for]
    syncService: some SyncService
) {
    let api = app.grouped("v1")
[for (cls : EClass | resources(pkg))]
    configure[cls.name/]Routes(api, service: [cls.name.toLowerFirst()/]Service)
[/for]
    configureSyncRoutes(api, service: syncService)
}
[for (cls : EClass | resources(pkg))]

[generateRoutesForClass(cls)/]
[/for]

/// Registers the synchronisation and export routes.
func configureSyncRoutes(_ routes: any RoutesBuilder, service: some SyncService) {
    let sync = routes.grouped("sync")
    sync.get("status") { _ async throws -> SyncStatusDTO in
        try await service.status()
    }
    sync.post("push") { req async throws -> PushResultDTO in
        try await service.push(req.content.decode(ChangeSetDTO.self))
    }
    sync.get("pull") { req async throws -> ChangeSetDTO in
        let since = req.query['['/]String.self, at: "since"[']'/]
        return try await service.pull(since: since)
    }

    let export = routes.grouped("export")
    export.get("xmi") { _ async throws -> Response in
        Response(
            status: .ok,
            headers: ['['/]"Content-Type": "application/xml"[']'/],
            body: .init(string: try await service.exportXMI()))
    }
    export.get("json") { _ async throws -> Response in
        Response(
            status: .ok,
            headers: ['['/]"Content-Type": "application/json"[']'/],
            body: .init(string: try await service.exportJSON()))
    }
}
[/template]

[comment Generate the routes of a resource class /]
[template private generateRoutesForClass(cls : EClass)]
/// Registers the [cls.name/] routes.
func configure[cls.name/]Routes(_ routes: any RoutesBuilder, service: some [cls.name/]Service) {
    let group = routes.grouped("[cls.name.toLower()/]s")
    group.get { req async throws -> Page<[cls.name/]DTO> in
        let limit = req.query['['/]Int.self, at: "limit"[']'/] ?? 20
        let offset = req.query['['/]Int.self, at: "offset"[']'/] ?? 0
        return try await service.list(limit: limit, offset: offset)
    }
    group.get(":id") { req async throws -> [cls.name/]DTO in
        let id = try req.parameters.require("id")
        guard let found = try await service.find(id: id) else {
            throw Abort(.notFound, reason: "No [cls.name/] has the identifier \(id)")
        }
        return found
    }
    group.post { req async throws -> [cls.name/]DTO in
        try await service.create(req.content.decode([cls.name/]InputDTO.self))
    }
    group.put(":id") { req async throws -> [cls.name/]DTO in
        let id = try req.parameters.require("id")
        return try await service.update(id: id, input: req.content.decode([cls.name/]InputDTO.self))
    }
    group.delete(":id") { req async throws -> HTTPStatus in
        try await service.delete(id: req.parameters.require("id"))
        return .noContent
    }
}
[/template]
