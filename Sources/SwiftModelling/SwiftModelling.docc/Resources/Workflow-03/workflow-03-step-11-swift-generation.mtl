[comment encoding = UTF-8 /]
[comment]
  Generates Swift value types that read and write models in the JSON format
  of swift-ecore convert: every object carries its eClass, attributes keep
  their names, enumeration literals are strings, contained objects are
  nested and other references are {"$ref": "fragment path"} objects.
  The model of this template is the metamodel itself (an .ecore file).
[/comment]
[module GenerateSwiftModels('http://www.eclipse.org/emf/2002/Ecore')]

[template public generate(pkg : EPackage)]
[file ('ModelReference.swift', false, 'UTF-8')]
[header(pkg, 'ModelReference.swift')/]

/// A reference to another object of the same model.
///
/// The JSON format writes a reference as an object whose `$ref` key holds
/// the fragment path of the target, such as `//@members.0`.
public struct ModelReference: Codable, Hashable, Sendable {
    /// The fragment path of the referenced object.
    public var path: String

    /// Creates a reference to the object at a fragment path.
    ///
    /// - Parameter path: The fragment path of the referenced object.
    public init(path: String) {
        self.path = path
    }

    private enum CodingKeys: String, CodingKey {
        case path = "$ref"
    }
}
[/file]
[for (e : EEnum | pkg.eClassifiers->filter(EEnum))]
[file (e.name + '.swift', false, 'UTF-8')]
[header(pkg, e.name + '.swift')/]

/// The [e.name/] enumeration of [pkg.name/].
///
/// The raw values are the literal names that XMI and JSON files hold.
public enum [e.name/]: String, Codable, CaseIterable, Sendable {
[for (literal : EEnumLiteral | e.eLiterals)]
    case [caseName(literal.name)/] = "[literal.name/]"
[/for]
}
[/file]
[/for]
[for (c : EClass | pkg.eClassifiers->filter(EClass))]
[file (c.name + '.swift', false, 'UTF-8')]
[header(pkg, c.name + '.swift')/]

/// A [c.name/] object of [pkg.name/].
public struct [c.name/]: Codable, Hashable, Sendable {
    /// The class of the object as a URI, as the JSON format writes it.
    public var eClass: String?
[for (a : EAttribute | c.eAllAttributes)]
    /// The [a.name/] attribute.
    public var [a.name/]: [attributeType(a)/]?
[/for]
[for (r : EReference | c.eAllReferences)]
    /// [if (r.containment)]The contained[else]References to the[/if] [r.name/] ([r.eType.name/]).
    public var [r.name/]: [referenceType(r)/]?
[/for]

    /// Creates an object of the class.
    public init() {
        eClass = "[pkg.nsURI/]#//[c.name/]"
    }
}
[/file]
[/for]
[/template]

[template private header(pkg : EPackage, fileName : String)]
// [fileName/]
// Generated from [pkg.name/].ecore by GenerateSwiftModels.mtl.
// Regenerate instead of editing.

import Foundation
[/template]

[comment Converts a literal name such as NOT_STARTED to notStarted. /]
[template private caseName(name : String)][for (word : String | name.toLower().tokenize('_'))][if (i = 1)][word/][else][word.toUpperFirst()/][/if][/for][/template]

[query private attributeType(a : EAttribute) : String =
    let base : String = scalarType(a) in
    if a.upperBound = 1 then base else '[' + base + ']' endif
/]

[query private scalarType(a : EAttribute) : String =
    if a.eType.oclIsKindOf(EEnum) then a.eType.name
    else if a.eType.name = 'EInt' or a.eType.name = 'ELong' then 'Int'
    else if a.eType.name = 'EDouble' or a.eType.name = 'EFloat' then 'Double'
    else if a.eType.name = 'EBoolean' then 'Bool'
    else 'String'
    endif endif endif endif
/]

[query private referenceType(r : EReference) : String =
    let base : String = if r.containment then r.eType.name else 'ModelReference' endif in
    if r.upperBound = 1 then base else '[' + base + ']' endif
/]
