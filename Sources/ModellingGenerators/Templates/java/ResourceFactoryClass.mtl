[comment encoding = UTF-8 /]
[**
 * The Java file of the resource factory of a generator package.
 *
 * The factory creates the resource of the package. Depending on the resource kind and on the
 * extended metadata of the package, it configures the save and load options of the new resource:
 * extended metadata, schema locations, encoded attribute style, the lexical handler, and the
 * XML map of a mapped schema. The data type converter option of a package whose document root
 * uses converters is not written, and neither is the override hook of the Eclipse generator.
 *
 * This template writes the form for compliance level 5.0 and higher.
 **/]
[module ResourceFactoryClass('http://www.eclipse.org/emf/2002/GenModel', 'http://swift-modelling.org/typemapping/1.0')/]
[import JavaNames/]
[import JavaImports/]
[import Header/]
[import JavaDocumentation/]
[import JavaResources/]

[**
 * The complete text of the file that declares the resource factory of a generator package.
 **/]
[template public resourceFactoryClass(genPackage : GenPackage)]
[let genModel : GenModel = genPackage.genModel()]
[collect ('imports', genPackage.qualifiedResourceFactoryClassName())/]
[collect ('imports', Sequence{'org.eclipse.emf.common.util.URI', 'org.eclipse.emf.ecore.resource.Resource'})/]
[header(genPackage)/]
package [genPackage.utilitiesPackageName()/];


[emit ('imports') once][importBlock(items)/][/emit]

/**
 * <!-- begin-user-doc -->
 * The <b>Resource Factory</b> associated with the package.
 * <!-- end-user-doc -->
 * @see [genPackage.qualifiedResourceClassName()/]
[for (line | genPackage.packageTagLines())]
 * [line/]
[/for]
 * @generated
 */
[if (genModel.useGenerics() and genPackage.hasAPIDeprecatedTag())]
@Deprecated
[/if]
public class [genPackage.resourceFactoryClassName()/] extends [importedName('org.eclipse.emf.ecore.resource.impl.ResourceFactoryImpl')/]
{
[if (genModel.hasCopyrightField())]
  /**
   * <!-- begin-user-doc -->
   * <!-- end-user-doc -->
   * @generated
   */
  public static final [importedName('java.lang.String')/] copyright = [genModel.copyrightFieldLiteral()/];[nonNLS(genModel, 1)/]

[/if]
[if (genPackage.hasExtendedMetaData() and not genPackage.hasTargetNamespace())]
  /**
   * <!-- begin-user-doc -->
   * <!-- end-user-doc -->
   * @generated
   */
  protected [importedName('org.eclipse.emf.ecore.util.ExtendedMetaData')/] extendedMetaData;

[elseif (genPackage.hasXMLMap())]
  /**
   * <!-- begin-user-doc -->
   * <!-- end-user-doc -->
   * @generated
   */
  protected [importedName('org.eclipse.emf.ecore.xmi.XMLResource$XMLMap')/] xmlMap = new [importedName('org.eclipse.emf.ecore.xmi.impl.XMLMapImpl')/]();

[/if]
  /**
   * Creates an instance of the resource factory.
   * <!-- begin-user-doc -->
   * <!-- end-user-doc -->
   * @generated
   */
  public [genPackage.resourceFactoryClassName()/]()
  {
    super();
[if (genPackage.hasExtendedMetaData() and not genPackage.hasTargetNamespace())]
    extendedMetaData = new [importedName('org.eclipse.emf.ecore.util.BasicExtendedMetaData')/](new [importedName('org.eclipse.emf.ecore.impl.EPackageRegistryImpl')/]([importedName('org.eclipse.emf.ecore.EPackage')/].Registry.INSTANCE));
    extendedMetaData.putPackage(null, [importedName(genPackage.qualifiedPackageInterfaceName())/].eINSTANCE);
[elseif (genPackage.hasXMLMap() and not genPackage.hasTargetNamespace())]
    xmlMap.setNoNamespacePackage([importedName(genPackage.qualifiedPackageInterfaceName())/].eINSTANCE);
[/if]
  }

  /**
   * Creates an instance of the resource.
   * <!-- begin-user-doc -->
   * <!-- end-user-doc -->
   * @generated
   */
[if (genModel.useClassOverrideAnnotation())]
  @Override
[/if]
  public Resource createResource(URI uri)
  {
[if (genPackage.hasExtendedMetaData())]
    [importedName('org.eclipse.emf.ecore.xmi.XMLResource')/] result = new [genPackage.resourceClassName()/](uri);
    result.getDefaultSaveOptions().put([importedName('org.eclipse.emf.ecore.xmi.XMLResource')/].OPTION_EXTENDED_META_DATA, [if (genPackage.hasTargetNamespace())]Boolean.TRUE[else]extendedMetaData[/if]);
    result.getDefaultLoadOptions().put([importedName('org.eclipse.emf.ecore.xmi.XMLResource')/].OPTION_EXTENDED_META_DATA, [if (genPackage.hasTargetNamespace())]Boolean.TRUE[else]extendedMetaData[/if]);

    result.getDefaultSaveOptions().put([importedName('org.eclipse.emf.ecore.xmi.XMLResource')/].OPTION_SCHEMA_LOCATION, Boolean.TRUE);

    result.getDefaultLoadOptions().put([importedName('org.eclipse.emf.ecore.xmi.XMLResource')/].OPTION_USE_ENCODED_ATTRIBUTE_STYLE, Boolean.TRUE);
    result.getDefaultSaveOptions().put([importedName('org.eclipse.emf.ecore.xmi.XMLResource')/].OPTION_USE_ENCODED_ATTRIBUTE_STYLE, Boolean.TRUE);

    result.getDefaultLoadOptions().put([importedName('org.eclipse.emf.ecore.xmi.XMLResource')/].OPTION_USE_LEXICAL_HANDLER, Boolean.TRUE);
[elseif (genPackage.hasXMLMap())]
    [importedName('org.eclipse.emf.ecore.xmi.XMLResource')/] result = new [genPackage.resourceClassName()/](uri);
    result.getDefaultSaveOptions().put([importedName('org.eclipse.emf.ecore.xmi.XMLResource')/].OPTION_XML_MAP, xmlMap);
    result.getDefaultLoadOptions().put([importedName('org.eclipse.emf.ecore.xmi.XMLResource')/].OPTION_XML_MAP, xmlMap);
[else]
    Resource result = new [genPackage.resourceClassName()/](uri);
[/if]
    return result;
  }

} //[genPackage.resourceFactoryClassName()/]
[/let]
[/template]
