   * @ordered
   */
[if (genFeature.hasAPIDeprecatedTag())]
  @Deprecated
[/if]
  protected [genFeature.featureType()/] [genFeature.localName()/][if (genFeature.hasEDefault())] = [genFeature.eDefaultName()/][/if];

[/if]
[/if]
[/if]
[if (genClass.isESetFieldOf(genFeature))]
[if (genClass.isESetFlagOf(genFeature))]
  /**
   * The flag representing whether the [genFeature.formattedFeatureName()/] [genFeature.featureKind()/] has been set.
   * <!-- begin-user-doc -->
