[comment Members /]

[**
 * The text of a notification of a change of a feature.
 **/]
[template public notificationClass()][importedName('org.eclipse.emf.ecore.impl.ENotificationImpl')/][/template]

[**
 * The declarations or methods for one feature.
 **/]
[template public featureMembers(genClass : GenClass, genFeature : GenFeature, isInterface : Boolean, isImplementation : Boolean)]
[if (genFeature.isGetVisible(isImplementation))]
[genClass.getterMember(genFeature, isInterface, isImplementation)/]
[/if]
[if (isImplementation and genFeature.isBasicGet())]
[genClass.basicGetMember(genFeature)/]
[/if]
[if (isImplementation and genFeature.isBasicSet())]
[genClass.basicSetMember(genFeature)/]
[/if]
[if (not genFeature.isMany() and genFeature.isChangeable() and (isImplementation or not genFeature.isSuppressedSetVisibility()))]
[genClass.setterMember(genFeature, isInterface, isImplementation)/]
[/if]
[if (isImplementation and genFeature.isBasicUnset())]
[genClass.basicUnsetMember(genFeature)/]
[/if]
[if (genFeature.isUnsettableFeature() and genFeature.isChangeable() and (isImplementation or not genFeature.isSuppressedUnsetVisibility()))]
[genClass.unsetMember(genFeature, isInterface, isImplementation)/]
[/if]
[if (genFeature.isUnsettableFeature() and (isImplementation or not genFeature.isSuppressedIsSetVisibility()))]
[genClass.isSetMember(genFeature, isInterface, isImplementation)/]
[/if]
[/template]

[**
 * Whether the getter of a feature is written: it is in the implementation, and in the interface unless suppressed.
 **/]
[query public isGetVisible(genFeature : GenFeature, isImplementation : Boolean) : Boolean = isImplementation or not genFeature.isSuppressedGetVisibility()/]

[**
 * The override annotation of a method, where the compliance level asks for one.
 **/]
[template public overrideAnnotation(genClass : GenClass, isInterface : Boolean, isImplementation : Boolean)]
[if (genClass.genModel().useInterfaceOverrideAnnotation() and not (isInterface and isImplementation) and not genClass.isMapEntry())]
  @Override
[/if]
[/template]

[**
 * The javadoc of the getter of a feature in an interface.
 **/]
[template public getterJavadoc(genClass : GenClass, genFeature : GenFeature)]
[let genModel : GenModel = genClass.genModel()]
  /**
   * Returns the value of the '<em><b>[genFeature.formattedFeatureName()/]</b></em>' [genFeature.featureKind()/].
[if (genFeature.isMany() and not genFeature.isMapFeature() and not genFeature.isFeatureMapFeature() or genFeature.isFeatureMapFeature())]
   * The list contents are of type {@link [genFeature.listItemTypeName().substituteAll('$', '.')/]}.
[elseif (genFeature.isMapFeature())]
   * The key is of type {@link [qualifiedTypeName(genFeature.entryFeature('key').eType)/]},
   * and the value is of type {@link [qualifiedTypeName(genFeature.entryFeature('value').eType)/]},
[elseif (not genFeature.ecoreFeature.defaultValueLiteral.oclIsUndefined())]
   * The default value is <code>[javaStringLiteral(genFeature.ecoreFeature.defaultValueLiteral)/]</code>.
[/if]
[if (genFeature.isEnumFeature())]
   * The literals are from the enumeration {@link [genFeature.itemTypeName()/]}.
[/if]
[if (genFeature.isBidirectional() and not genFeature.reverseGenFeature().genClass().isMapEntry())]
[if (not genFeature.reverseGenFeature().isSuppressedGetVisibility())]
   * It is bidirectional and its opposite is '{@link [genFeature.reverseGenFeature().genClass().qualifiedInterfaceName()/]#[genFeature.reverseGenFeature().getterName()/] <em>[genFeature.reverseGenFeature().formattedFeatureName()/]</em>}'.
[/if]
[/if]
   * <!-- begin-user-doc -->
   * <!-- end-user-doc -->
[if (genFeature.hasDocumentation())]
   * <!-- begin-model-doc -->
   * [genFeature.documentation().indentLines('* ')/]
   * <!-- end-model-doc -->
[/if]
   * @return the value of the '<em>[genFeature.formattedFeatureName()/]</em>' [genFeature.featureKind()/].
[if (genFeature.isEnumFeature())]
   * @see [genFeature.itemTypeName()/]
[/if]
[if (genFeature.isUnsettableFeature())]
[if (not genFeature.isSuppressedIsSetVisibility())]
   * @see #isSet[genFeature.accessorName()/]()
[/if]
[if (genFeature.isChangeable() and not genFeature.isSuppressedUnsetVisibility())]
   * @see #unset[genFeature.accessorName()/]()
[/if]
[/if]
[if (genFeature.isChangeable() and not genFeature.isMany() and not genFeature.isSuppressedSetVisibility())]
   * @see #set[genFeature.accessorName()/]([genFeature.rawFeatureType()/])
[/if]
[if (not genModel.isOn('suppressEMFMetaData'))]
   * @see [genClass.genPackage().qualifiedPackageInterfaceName()/]#get[genFeature.genClass().name()/]_[genFeature.capName()/]()
[/if]
[if (genFeature.isBidirectional() and not genFeature.reverseGenFeature().genClass().isMapEntry())]
[if (not genFeature.reverseGenFeature().isSuppressedGetVisibility())]
   * @see [genFeature.reverseGenFeature().genClass().qualifiedInterfaceName()/]#[genFeature.reverseGenFeature().getterName()/]
[/if]
[/if]
[if (not genModel.isOn('suppressEMFModelTags'))]
[genClass.modelTagLines('   * ', genFeature.modelInfo())/]
[/if]
   * @generated
   */
[/let]
[/template]

[**
 * A plain documentation comment for a method of an implementation.
 **/]
[template public plainJavadoc(genFeature : GenFeature)]
  /**
   * <!-- begin-user-doc -->
   * <!-- end-user-doc -->
[genFeature.apiLines('   * ')/]
   * @generated
   */
[/template]

