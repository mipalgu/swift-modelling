[if (genFeature.hasAPIDeprecatedTag())]
  @Deprecated
[/if]
  protected [genFeature.internalType()/] [genFeature.localName()/];

[/if]
[else]
[if (genFeature.hasEDefault())]
  /**
   * The default value of the '{@link #[genFeature.getterName()/]() <em>[genFeature.formattedFeatureName()/]</em>}' [genFeature.featureKind()/].
   * <!-- begin-user-doc -->
   * <!-- end-user-doc -->
   * @see #[genFeature.getterName()/]()
[genFeature.apiLines('   * ')/]
   * @generated
   * @ordered
   */
[if (genFeature.hasAPIDeprecatedTag())]
  @Deprecated
[/if]
  protected static final [genFeature.featureType()/] [genFeature.eDefaultName()/] = [genFeature.staticDefaultValue()/];[nonNLS(genClass.genModel(), 1)/]

[/if]
[if (genClass.isFieldOf(genFeature))]
[if (genClass.isFlagOf(genFeature))]
  /**
   * The flag representing the value of the '{@link #[genFeature.getterName()/]() <em>[genFeature.formattedFeatureName()/]</em>}' [genFeature.featureKind()/].
   * <!-- begin-user-doc -->
   * <!-- end-user-doc -->
   * @see #[genFeature.getterName()/]()
[genFeature.apiLines('   * ')/]
   * @generated
   * @ordered
   */
[if (genFeature.hasAPIDeprecatedTag())]
  @Deprecated
[/if]
  protected static final int [genFeature.featureUpperName()/]_EFLAG = 1 << [(genClass.flagIndex(genFeature) - 32 * (genClass.flagIndex(genFeature) / 32)).toString()/];

[else]
  /**
   * The cached value of the '{@link #[genFeature.getterName()/]() <em>[genFeature.formattedFeatureName()/]</em>}' [genFeature.featureKind()/].
   * <!-- begin-user-doc -->
