[comment encoding = UTF-8 /]
[**
 * The fields and methods of the features of a class.
 *
 * The templates here write, for one feature, the declarations of the interface or the fields and
 * accessor methods of the implementation: getters, setters, the methods that keep inverse references
 * in step, and the methods for features that can be unset.
 **/]
[module ClassFeature('http://www.eclipse.org/emf/2002/GenModel', 'http://swift-modelling.org/typemapping/1.0')/]
[import JavaNames/]
[import JavaImports/]
[import JavaTypes/]
[import JavaDocumentation/]
[import Header/]
[import ClassQueries/]
[import ClassModelInfo/]

[comment Names /]

[**
 * The text of the type of a feature, registering its imports.
 **/]
[template public featureType(genFeature : GenFeature)][if (genFeature.isFeatureMapFeature())][importedName(featureMapTypeName())/][else][genFeature.importedType()/][/if][/template]

[**
 * The text of the type of a feature for fields: the interface of a map or feature map type.
 **/]
[template public internalType(genFeature : GenFeature)][if (genFeature.isFeatureMapFeature())][importedName(featureMapTypeName())/][else][genFeature.importedType()/][/if][/template]

[**
 * The text of the raw type that appears in a link to a setter: a list type without arguments is not needed here because setters are single valued.
 **/]
[template public rawFeatureType(genFeature : GenFeature)][if (genFeature.isMany())][importedName(genFeature.listTypeName())/][else][importedName(genFeature.itemTypeName())/][/if][/template]

[**
 * The text of the imported package interface name of a class.
 **/]
[template public packageInterface(genClass : GenClass)][importedName(genClass.genPackage().qualifiedPackageInterfaceName())/][/template]

[**
 * The Java constant that identifies a feature in the context of a class.
 **/]
[template public featureID(genClass : GenClass, genFeature : GenFeature)][genClass.packageInterface()/].[genClass.classifierIDName()/]__[genFeature.featureUpperName()/][/template]

[**
 * The Java expression that denotes the metaclass of a feature in the package interface.
 **/]
[template public featureLiteral(genFeature : GenFeature)][genFeature.genClass().packageInterface()/].Literals.[genFeature.genClass().classifierIDName()/]__[genFeature.featureUpperName()/][/template]

[**
 * The name of the field that holds the value of a feature, the default constant of a feature, and the flag constants.
 **/]
[query public eDefaultName(genFeature : GenFeature) : String = genFeature.featureUpperName() + '_EDEFAULT'/]

[**
 * The imported name of the interface of a class, without type arguments.
 **/]
[template public rawInterfaceName(genClass : GenClass)][importedName(genClass.internalInterfaceName())/][/template]

[**
 * The text that casts an expression to the runtime's internal object type if the type of the feature is a model class.
 **/]
[template public asInternalEObject(genFeature : GenFeature, expression : String, parenthesize : Boolean)][if (genFeature.hasClassType() and not genFeature.typeGenClass().genModel().isOn('suppressInterfaces'))][if (parenthesize)]([/if]([importedName('org.eclipse.emf.ecore.InternalEObject')/])[expression/][if (parenthesize)])[/if][else][expression/][/if][/template]

[**
 * The name of a feature as an expression of the runtime's base type, for calling eIsProxy.
 **/]
[template public safeNameAsEObject(genFeature : GenFeature)][if (genFeature.isEObjectExtensionFeature())][genFeature.localName()/][else](([importedName(eObjectTypeName())/])[genFeature.localName()/])[/if][/template]

[**
 * The cast to the runtime's base type that an expression needs before it is used as a model object.
 **/]
[template public eObjectCast(genFeature : GenFeature)][if (not genFeature.isEObjectExtensionFeature())]([importedName(eObjectTypeName())/])[/if][/template]

[**
 * The cast of a value to the internal type of the feature.
 **/]
[template public nonEObjectTypeCast(genFeature : GenFeature)][if (not genFeature.isEObjectFeature())]([genFeature.featureType()/])[/if][/template]

[comment Default values /]

[**
 * The literal of the default value of an attribute in Java.
 **/]
[template public staticDefaultValue(genFeature : GenFeature)][let literal : OclAny = genFeature.ecoreFeature.defaultValueLiteral][let type : String = genFeature.itemTypeName()][if (genFeature.ecoreFeature.eType.oclIsKindOf(EEnum))][let genEnum : OclAny = genFeature.ecoreFeature.eType.genClassifier()][importedName(genEnum.qualifiedEnumName())/].[genEnum.defaultLiteralConstant(literal)/][/let][elseif (type = 'java.lang.String')][if (literal.oclIsUndefined())]null[else][javaStringLiteral(literal)/][/if][elseif (isBlank(literal))][zeroValue(type)/][elseif (type = 'boolean')][literal.toLowerCase()/][elseif (type = 'long')][literal/]L[elseif (type = 'float')][literal/]F[elseif (type = 'short')](short)[literal/][elseif (type = 'byte')](byte)[literal/][elseif (type = 'char')]'[literal/]'[elseif (type = 'double')][if (literal.contains('.') or literal.contains('E') or literal.contains('e'))][literal/][else][literal/].0[/if][elseif (isPrimitiveType(type))][literal/][else][genFeature.genClass().genPackage().qualifiedFactoryInstance()/].createFromString([genFeature.genClass().packageInterface()/].eINSTANCE.get[genFeature.ecoreFeature.eType.name/](), [javaStringLiteral(literal)/])[/if][/let][/let][/template]

[**
 * The constant of the enumeration literal that a default value denotes: the literal of that text, otherwise the first one.
 **/]
[query public defaultLiteralConstant(genEnum : GenEnum, literal : OclAny) : String = (if genEnum.genEnumLiterals->exists(l | l.ecoreEnumLiteral.literal = literal) then genEnum.genEnumLiterals->select(l | l.ecoreEnumLiteral.literal = literal)->first() else genEnum.genEnumLiterals->first() endif).enumLiteralInstanceConstantName()/]

[**
 * The expression that reaches the factory instance of a package.
 **/]
[query public qualifiedFactoryInstance(genPackage : GenPackage) : String = genPackage.interfacePackageName() + '.' + genPackage.factoryInterfaceName() + '.eINSTANCE'/]

