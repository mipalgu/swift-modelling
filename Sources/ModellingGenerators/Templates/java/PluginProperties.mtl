[comment encoding = UTF-8 /]
[**
 * The properties file of the plugin of a model project.
 *
 * The file names the bundle and its vendor, and the content types of the packages that declare one.
 * Its first line is a comment that carries the copyright text, or is empty.
 **/]
[module PluginProperties('http://www.eclipse.org/emf/2002/GenModel', 'http://swift-modelling.org/typemapping/1.0')/]
[import JavaNames/]
[import Header/]
[import JavaResources/]
[import JavaProject/]

[**
 * The comment that opens a properties file: the copyright text with a hash before each line, or a lone hash.
 **/]
[template public propertiesHeader(genModel : GenModel)]
[if (not copyrightText(genModel).oclIsUndefined())]
# [copyrightText(genModel).indentLines('# ')/]
[else]
#
[/if]
[/template]

[**
 * The complete text of the properties file of the plugin of a generator model.
 **/]
[template public pluginProperties(genModel : GenModel)]
[genModel.propertiesHeader()/]

pluginName = [genModel.modelBundleName()/]
providerName = [genModel.modelBundleVendorName()/]
[for (genPackage : GenPackage | genModel.packagesWithClassifiers()->select(p | p.isContentType()))]
[if (i = 1)]

[/if]
_UI_[genPackage.setting('prefix')/]_content_type = [genPackage.setting('prefix')/] File
[/for]
[/template]
