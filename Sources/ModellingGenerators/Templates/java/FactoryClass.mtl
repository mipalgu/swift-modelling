[comment encoding = UTF-8 /]
[**
 * The Java files of the factory of a generator package.
 *
 * Two files are written for a package that has classifiers: the factory interface, which declares the
 * singleton instance, one create method for each concrete class and the accessor of the package, and
 * the factory implementation, which creates instances of the classes, converts the values of
 * enumerations and data types to and from text, and finds the factory that is registered for the package.
 *
 * Data types are converted by the factory of the runtime unless the generator model supplies create
 * and convert bodies or switches on data type converters. Both forms are written for compliance level 5.0
 * and higher.
 *
 * Not supported: suppressed interfaces and suppressed reflective metadata, classes with type parameters,
 * map entry classes and classes that are external interfaces, data types that derive from a base
 * type, list item type or union member types through extended metadata, data types with array or
 * parameterised instance types, and the compliance levels below 5.0. A class counts as an extension of
 * the root object interface when the generator model's root interface is the default one.
 **/]
[module FactoryClass('http://www.eclipse.org/emf/2002/GenModel', 'http://swift-modelling.org/typemapping/1.0')/]
[import JavaNames/]
[import JavaImports/]
[import JavaTypes/]
[import Header/]
[import JavaDocumentation/]
[import JavaUtilities/]

[comment Names /]

[**
 * The package that holds the factory implementation of a package.
 **/]
[query public factoryClassPackageName(genPackage : GenPackage) : String = if genPackage.genModel().isOn('suppressInterfaces') then genPackage.reflectionPackageName() else genPackage.classPackageName() endif/]

[**
 * The qualified name of the factory interface of a package.
 **/]
[query public factoryQualifiedInterfaceName(genPackage : GenPackage) : String = genPackage.reflectionPackageName() + '.' + genPackage.factoryInterfaceName()/]

[**
 * The qualified name of the factory implementation of a package.
 **/]
[query public factoryQualifiedClassName(genPackage : GenPackage) : String = genPackage.factoryClassPackageName() + '.' + genPackage.factoryClassName()/]

[**
 * The name of the variable that holds the factory registered for a package.
 **/]
[query public factoryRegisteredName(genPackage : GenPackage) : String = 'the' + genPackage.factoryName()/]

[**
 * The name of the accessor of a package in its factory, without the get prefix.
 **/]
[query public factoryPackageAccessorName(genPackage : GenPackage) : String = genPackage.prefixedName('Package')/]

[**
 * The name of the variable of a class in its create method: the uncapitalised name, escaped if reserved.
 **/]
[query public factoryVariableName(genClass : GenClass) : String = safeName(genClass.name().uncapPrefixedName())/]

[comment Conditions /]

[**
 * Whether a package has a class named like the implementation class of another one.
 **/]
[query public hasInterfaceImplConflict(genPackage : GenPackage) : Boolean = genPackage.genClasses->exists(c | genPackage.genClasses->exists(d | d.name() = c.name() + 'Impl'))/]

[**
 * Whether a class or enumeration of a package has the name of a type that code can use without importing it.
 **/]
[query public hasJavaLangConflict(genPackage : GenPackage) : Boolean = genPackage.genClasses->exists(c | isImplicitType(c.name())) or genPackage.genEnums->exists(e | isImplicitType(e.name()))/]

[**
 * Whether the factory implementation imports all types of the interface package with one wildcard import:
 * unless the generator model organises its imports, which names every type that the file uses instead.
 **/]
[query public factoryUsesWildcard(genPackage : GenPackage) : Boolean = not genPackage.genModel().isOn('importOrganizing') and not genPackage.hasJavaLangConflict() and not genPackage.hasInterfaceImplConflict() and genPackage.classPackageName() <> genPackage.interfacePackageName()/]

[**
 * Whether the classes that code creates need a cast to the root object interface in the generic create method.
 **/]
[query public factoryNeedsObjectCast(genClass : GenClass) : Boolean = not (not genClass.isMapEntry and genClass.genModel().setting('rootExtendsInterface') = 'org.eclipse.emf.ecore.EObject')/]

[**
 * Whether the factory interface declares a create method for a class.
 **/]
[query public hasFactoryInterfaceCreateMethod(genClass : GenClass) : Boolean = not genClass.isAbstract and not genClass.isMapEntry/]

[**
 * Whether the code style of the generator model asks for a clean-up.
 **/]
[query public factoryHasCodeStyle(genModel : GenModel, style : String) : Boolean = genModel.isSetting('codeStyle') and genModel.setting('codeStyle').toString().contains(style)/]

[**
 * Whether an element is a generator enumeration.
 **/]
[query public factoryIsEnum(classifier : OclAny) : Boolean = classifier.oclIsKindOf(GenEnum)/]

[**
 * Whether the deprecation of a classifier needs to be silenced in the factory implementation.
 **/]
[query public factoryNeedsDeprecationSuppression(genPackage : GenPackage) : Boolean = not genPackage.hasAPIDeprecatedTag() and (genPackage.genClasses->exists(c | not c.isAbstract and c.hasAPIDeprecatedTag()) or genPackage.genEnums->exists(e | e.hasAPIDeprecatedTag()) or genPackage.genDataTypes->exists(d | d.hasAPIDeprecatedTag()))/]

[comment Data types /]

[**
 * The source of the annotation in which a model carries the create and convert bodies of a data type.
 **/]
[query public factoryAnnotationSource() : String = 'http://www.eclipse.org/emf/2002/GenModel'/]


[**
 * The data types of a package that the factory converts: its enumerations, then its other data types.
 **/]
[query public allGenDataTypes(genPackage : GenPackage) : OclAny = genPackage.genEnums->union(genPackage.genDataTypes)/]

[**
 * The data types of a package that have a textual form.
 **/]
[query public serializableGenDataTypes(genPackage : GenPackage) : OclAny = genPackage.allGenDataTypes()->select(d | factoryIsSerializable(d))/]

[**
 * Whether values of a data type have a textual form. Enumerations always do.
 **/]
[query public factoryIsSerializable(dataType : OclAny) : Boolean = if factoryIsEnum(dataType) then true else dataType.ecoreDataType.serializable endif/]

[**
 * The qualified name of the Java type of a data type: the enum of an enumeration, otherwise the instance class.
 **/]
[query public factoryInstanceName(dataType : OclAny) : String = if factoryIsEnum(dataType) then dataType.qualifiedEnumName() else instanceClassName(dataType.ecoreDataType) endif/]

[**
 * The qualified name of the reference type of a data type: the wrapper class of a primitive type.
 **/]
[query public factoryObjectInstanceName(dataType : OclAny) : String = objectTypeName(factoryInstanceName(dataType))/]

[**
 * Whether a data type is a Java primitive type.
 **/]
[query public factoryIsPrimitive(dataType : OclAny) : Boolean = isPrimitiveType(factoryInstanceName(dataType))/]

[**
 * Whether the instances of a data type are plain objects, so that no cast is needed.
 **/]
[query public factoryIsObjectType(dataType : OclAny) : Boolean = factoryInstanceName(dataType) = 'java.lang.Object'/]

[**
 * Whether the generator model supplies the code that creates values of a data type from text.
 **/]
[query public hasCreatorBody(dataType : OclAny) : Boolean = not factoryCreatorBody(dataType).oclIsUndefined()/]

[**
 * Whether the generator model supplies the code that converts values of a data type to text.
 **/]
[query public hasConverterBody(dataType : OclAny) : Boolean = not factoryConverterBody(dataType).oclIsUndefined()/]

[**
 * The code that creates values of a data type from text, taken from the generator model or the model annotation.
 **/]
[query public factoryCreatorBody(dataType : OclAny) : OclAny = if factoryIsEnum(dataType) then null else (if dataType.isSetting('create') then dataType.setting('create') else dataType.annotationDetail(factoryAnnotationSource(), 'create') endif) endif/]

[**
 * The code that converts values of a data type to text, taken from the generator model or the model annotation.
 **/]
[query public factoryConverterBody(dataType : OclAny) : OclAny = if factoryIsEnum(dataType) then null else (if dataType.isSetting('convert') then dataType.setting('convert') else dataType.annotationDetail(factoryAnnotationSource(), 'convert') endif) endif/]

[**
 * Whether the factory offers separate create and convert methods for a data type.
 **/]
[query public factoryHasConverters(genPackage : GenPackage) : Boolean = genPackage.isOn('dataTypeConverters')/]

[comment Documentation /]

[**
 * The lines of the API tags that the documentation of an element carries, with a link for tags that have a text.
 **/]
[query public factoryApiTagLines(element : OclAny, link : String) : OclAny = Sequence{factoryTagLine(element, 'since', ''), factoryTagLine(element, 'deprecated', link), factoryTagLine(element, 'noreference', link)}->select(l | l.size() > 0)/]

[query factoryTagLine(element : OclAny, tag : String, link : String) : String = if not element.hasDocumentationTag(tag) then '' else (if element.documentationTagText(tag).size() = 0 then (if tag = 'since' then '' else '@' + tag endif) else (if tag = 'since' or link.size() = 0 then '@' + tag + ' ' + element.documentationTagText(tag) else '@' + tag + ' See {@link ' + link + ' model documentation} for details.' endif) endif) endif/]

[**
 * Writes a type name: a simple name when the factory implementation imports the whole interface
 * package, otherwise the name that the import handling chooses.
 **/]
[template public factoryTypeRef(genPackage : GenPackage, qualifiedName : String, wildcard : Boolean)][if (wildcard and qualifiedName.packageOf() = genPackage.interfacePackageName())][qualifiedName.baseName()/][else][importedName(qualifiedName)/][/if][/template]

[comment Bodies supplied by the model /]

[**
 * The qualified names that a body names between the markers of an import expression.
 **/]
[query public factoryBodyImports(body : String) : OclAny = if body.index('<%') < 1 then Sequence{} else (let rest : String = body.substring(body.index('<%') + 2) in (if rest.index('%>') < 1 then Sequence{} else Sequence{rest.substring(1, rest.index('%>') - 1)}->union(factoryBodyImports(rest.substring(rest.index('%>') + 2))) endif)) endif/]

[**
 * A body with its import expressions replaced by the names that the file uses for them. The imports must
 * have been registered with factoryRegisterBodyImports.
 **/]
[query public factoryResolveBody(body : String) : String = if body.index('<%') < 1 then body else (let rest : String = body.substring(body.index('<%') + 2) in (if rest.index('%>') < 1 then body else body.substring(1, body.index('<%') - 1) + resolvedName(rest.substring(1, rest.index('%>') - 1)) + factoryResolveBody(rest.substring(rest.index('%>') + 2)) endif)) endif/]

[**
 * A body with its import expressions resolved; the template engine indents the lines after the first.
 **/]
[query public factoryBodyText(body : String) : String = factoryResolveBody(body)/]

[**
 * Registers the imports that a body names.
 **/]
[template public factoryRegisterBodyImports(body : String)]
[for (n | factoryBodyImports(body))]
[collect ('imports', n.importName())/]
[/for]
[/template]

