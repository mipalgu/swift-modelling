[comment encoding = UTF-8 /]
[**
 * The Java files of a generator package: the package interface and the package implementation class.
 *
 * The interface holds the identifiers of classifiers, features and operations, the accessors of the runtime
 * objects that describe the classifiers, and optionally the nested Literals interface. The implementation
 * class creates and initialises those runtime objects, registers the package, and creates the annotations of
 * the model. Both are written by one template that knows whether it writes the interface, the implementation, or,
 * when the model suppresses interfaces or reflective metadata, the two together.
 *
 * Supported: the generator settings that the reference generator honours for models at compliance level 5.0 and higher
 * without generic types in the metamodel, with and without operation reflection, with loaded initialisation,
 * with literals interface, family and nested packages, content types, annotations (including constraints) and
 * dependencies on other packages of the model.
 *
 * Not supported: generic types and type parameters in the metamodel, generic exceptions, the GWT runtime platform,
 * models below compliance level 5.0 for the bounds of generic types, and the pseudo imports that keep names of
 * model classes from clashing with the nested types of the runtime.
 **/]
[module PackageClass('http://www.eclipse.org/emf/2002/GenModel', 'http://swift-modelling.org/typemapping/1.0')/]
[import JavaNames/]
[import JavaImports/]
[import JavaTypes/]
[import JavaDocumentation/]
[import Header/]
[import PackageNames/]

[**
 * The complete text of the file that declares the package interface of a generator package.
 **/]
[template public packageInterface(genPackage : GenPackage)]
[genPackage.packageClass(true, false)/]
[/template]

[**
 * The complete text of the file that declares the package implementation class of a generator package.
 **/]
[template public packageImplementation(genPackage : GenPackage)]
[genPackage.packageClass(genPackage.genModel().isOn('suppressEMFMetaData') or genPackage.genModel().isOn('suppressInterfaces'), true)/]
[/template]

[**
 * The complete text of a package interface, a package implementation, or both in one file.
 **/]
[template public packageClass(genPackage : GenPackage, isInterface : Boolean, isImplementation : Boolean)]
[let genModel : GenModel = genPackage.genModel()]
[let combined : Boolean = isInterface and isImplementation]
[collect ('imports', if isImplementation then genPackage.qualifiedPackageClassName() else genPackage.qualifiedPackageInterfaceName() endif)/]
[header(genPackage)/]
package [if (isImplementation and not genModel.isOn('suppressInterfaces'))][genPackage.classPackageName()/][else][genPackage.reflectionPackageName()/][/if];


[emit ('imports') once][importBlock(items)/][/emit]

[if (isInterface)]
/**
 * <!-- begin-user-doc -->
 * The <b>Package</b> for the model.
 * It contains accessors for the meta objects to represent
 * <ul>
 *   <li>each class,</li>
 *   <li>each feature of each class,</li>
[if (genModel.isOn('operationReflection'))]
 *   <li>each operation of each class,</li>
[/if]
 *   <li>each enum,</li>
 *   <li>and each data type</li>
 * </ul>
 * <!-- end-user-doc -->
[if (genPackage.hasDocumentation())]
 * <!-- begin-model-doc -->
 * [genPackage.documentation().indentLines('* ')/]
 * <!-- end-model-doc -->
[/if]
 * @see [genPackage.factoryInterfaceQualifiedName()/]
[genPackage.modelTag(' * ', genPackage.packageModelInfo())/]
 * @generated
 */
[else]
/**
 * <!-- begin-user-doc -->
 * An implementation of the model <b>Package</b>.
 * <!-- end-user-doc -->
[if (genPackage.hasOwnAPITags())]
 * [genPackage.ownAPITagLines()->join('\n * ')/]
[/if]
 * @generated
 */
[/if]
[if (genPackage.hasAPIDeprecatedTag())]
@Deprecated
[/if]
[if (isImplementation)]
[if (genModel.useGenerics() and anyDeprecated(genPackage.orderedClassifiers()) and not genPackage.hasAPIDeprecatedTag() and not genModel.isOn('suppressEMFMetaData'))]
@SuppressWarnings("deprecation")
[/if]
public class [genPackage.packageClassName()/] extends [importedName('org.eclipse.emf.ecore.impl.EPackageImpl')/][if (not isInterface)] implements [importedName(genPackage.qualifiedPackageInterfaceName())/][/if]
[else]
public interface [genPackage.packageInterfaceName()/] extends [importedName(ePackageClass())/]
[/if]
{
[if (genModel.hasCopyrightField())]
  /**
   * <!-- begin-user-doc -->
   * <!-- end-user-doc -->
   * @generated
   */
  [if (isImplementation)]public static final [/if][importedName('java.lang.String')/] copyright = [genModel.copyrightFieldLiteral()/];[nonNLS(genModel, 1)/]

[/if]
[if (isInterface)]
[genPackage.packageConstants(isImplementation)/]
[/if]
[if (isImplementation)]
[genPackage.packageImplementationHead()/]
[/if]
[genPackage.packageAccessors(isInterface, isImplementation)/]
[if (isImplementation)]
[genPackage.packageContents(isInterface)/]
[/if]
[if (isInterface and genPackage.isOn('literalsInterface'))]
[genPackage.literalsInterface(isImplementation)/]
[/if]
} //[if (isInterface)][genPackage.packageInterfaceName()/][else][genPackage.packageClassName()/][/if]
[/let]
