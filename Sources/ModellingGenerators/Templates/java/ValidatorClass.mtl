[comment encoding = UTF-8 /]
[**
 * The Java file of the validator of a generator package.
 *
 * A validator is written for a package that has constraints: constraints named in the Ecore
 * constraints annotation of a classifier, invariant operations of classes, and the facets of data
 * types. The validator class extends the validator class of the runtime. It dispatches by classifier,
 * calls the default constraints of the runtime and each named constraint of a class in turn, and
 * writes a method for each constraint of each classifier.
 *
 * A constraint with an expression in the annotation of a validation delegate of the package calls the
 * delegate with the expression, an invariant operation is called on the object, and any other
 * constraint becomes a method that carries a to-do body.
 *
 * This template writes the form for compliance level 5.0 and higher, for runtime version 2.4 and
 * later. The facets of data types that it writes are enumeration, pattern, minimum, maximum, lengths,
 * total digits and fraction digits. Facets that derive from a base type, item type facets and member
 * type facets of data types, classes that map to external interfaces, and constraints of a model with
 * a type parameter are not written.
 **/]
[module ValidatorClass('http://www.eclipse.org/emf/2002/GenModel', 'http://swift-modelling.org/typemapping/1.0')/]
[import JavaNames/]
[import JavaImports/]
[import JavaTypes/]
[import JavaDocumentation/]
[import JavaUtilities/]
[import SwitchClass/]
[import Header/]

[comment Constraints /]

[**
 * The source of the annotation that carries the constraints of a classifier.
 **/]
[query public constraintSource() : String = ecoreNamespace()/]

[**
 * Whether an operation is an invariant: the annotation says so, or it returns a boolean and takes a diagnostic chain and a map.
 **/]
[query public isInvariantOperation(operation : OclAny) : Boolean = if not operation.annotationDetail(ecoreNamespace(), 'invariant').oclIsUndefined() then operation.annotationDetail(ecoreNamespace(), 'invariant') = 'true' else (not operation.eType.oclIsUndefined() and operation.eType.javaClassName() = 'boolean' and operation.eParameters->size() = 2 and operation.eParameters->first().eType.javaClassName() = 'org.eclipse.emf.common.util.DiagnosticChain' and operation.eParameters->last().eType.javaClassName() = 'java.util.Map') endif/]

[**
 * The Java class of a data type of an operation signature; the map type of the Ecore package stands for the Java map.
 **/]
[query public javaClassName(dataType : OclAny) : String = if dataType.oclIsUndefined() then '' else (if dataType.name = 'EMap' then 'java.util.Map' else dataType.instanceClassName() endif) endif/]

[**
 * The invariant operations that a class declares.
 **/]
[query public invariantOperations(genClass : GenClass) : OclAny = genClass.ecoreClass.eOperations->select(o | isInvariantOperation(o))/]

[**
 * The constraints that the Ecore annotation of a classifier names.
 **/]
[query annotatedConstraints(classifier : OclAny) : OclAny = if classifier.annotationDetail(ecoreNamespace(), 'constraints').oclIsUndefined() then Sequence{} else classifier.annotationDetail(ecoreNamespace(), 'constraints').tokenize(' \t\r\n') endif/]

[**
 * The text of a facet of a data type, or nothing when it has none.
 **/]
[query public facet(dataType : OclAny, key : String) : OclAny = dataType.annotationDetail(extendedMetaDataSource(), key)/]

[**
 * Whether a data type has a facet.
 **/]
[query public hasFacet(dataType : OclAny, key : String) : Boolean = not dataType.facet(key).oclIsUndefined()/]

[**
 * Whether the facet for a total number of digits applies: the digits are positive and the type is a big number.
 **/]
[query public hasTotalDigits(dataType : OclAny) : Boolean = dataType.hasFacet('totalDigits') and dataType.facet('totalDigits').toInteger() > 0 and (dataType.dataTypeClassName() = 'java.math.BigDecimal' or dataType.dataTypeClassName() = 'java.math.BigInteger')/]

[**
 * The constraints that a data type declares itself, in the order in which the facets are checked.
 **/]
[query facetConstraints(dataType : OclAny) : OclAny = Sequence{if dataType.hasFacet('enumeration') then 'Enumeration' else '' endif, if dataType.hasFacet('pattern') then 'Pattern' else '' endif, if dataType.hasTotalDigits() then 'TotalDigits' else '' endif, if dataType.hasFacet('fractionDigits') and dataType.dataTypeClassName() = 'java.math.BigDecimal' then 'FractionDigits' else '' endif, if dataType.hasFacet('length') then 'MinLength' else '' endif, if dataType.hasFacet('length') then 'MaxLength' else '' endif, if dataType.hasFacet('minLength') then 'MinLength' else '' endif, if dataType.hasFacet('maxLength') then 'MaxLength' else '' endif, if dataType.hasFacet('minExclusive') or dataType.hasFacet('minInclusive') then 'Min' else '' endif, if dataType.hasFacet('maxExclusive') or dataType.hasFacet('maxInclusive') then 'Max' else '' endif}->select(c | c.size() > 0)->asOrderedSet()/]

[**
 * The constraints that a classifier declares itself. A class adds its invariant operations to the annotated constraints,
 * a data type adds the constraints of its facets.
 **/]
[query public genConstraints(classifier : OclAny) : OclAny = if classifier.ecoreClass.oclIsUndefined() then (if classifier.ecoreDataType.oclIsUndefined() then annotatedConstraints(classifier) else annotatedConstraints(classifier)->union(facetConstraints(classifier))->asOrderedSet() endif) else annotatedConstraints(classifier)->union(invariantOperations(classifier)->collect(o | o.name))->asOrderedSet() endif/]

[**
 * The constraints that the runtime checks for every object, for the runtime version of the generator model.
 **/]
[query public intrinsicConstraints(genModel : GenModel) : OclAny = Sequence{if genModel.runtimeMinorVersion() >= 5 then 'NoCircularContainment' else '' endif, 'EveryMultiplicityConforms', 'EveryDataValueConforms', 'EveryReferenceIsContained', if genModel.runtimeMinorVersion() >= 6 then 'EveryBidirectionalReferenceIsPaired' else '' endif, 'EveryProxyResolves', 'UniqueID', if genModel.runtimeMinorVersion() > 2 then 'EveryKeyUnique' else '' endif, if genModel.runtimeMinorVersion() > 2 then 'EveryMapEntryUnique' else '' endif}->select(c | c.size() > 0)/]

[**
 * All constraints that apply to a classifier: those of the runtime and of the base classes first, then its own.
 **/]
[query public allGenConstraints(classifier : OclAny) : OclAny = if classifier.ecoreClass.oclIsUndefined() then classifier.genConstraints() else classifier.genModel().intrinsicConstraints()->union(classifier.allBaseGenClasses->collect(b | b.genConstraints())->flatten())->union(classifier.genConstraints())->asOrderedSet() endif/]

[**
 * The class that implements a constraint for a class: the class itself or the nearest base class that declares it, or nothing for the constraints of the runtime.
 **/]
[query public constraintImplementor(classifier : OclAny, constraint : String) : OclAny = if classifier.genConstraints()->includes(constraint) then classifier else (if classifier.ecoreClass.oclIsUndefined() then null else firstImplementor(classifier.baseGenClasses, constraint) endif) endif/]

[query firstImplementor(bases : OclAny, constraint : String) : OclAny = if bases->isEmpty() then null else (if constraintImplementor(bases->first(), constraint).oclIsUndefined() then firstImplementor(bases->drop(1), constraint) else constraintImplementor(bases->first(), constraint) endif) endif/]

[**
 * The class that a redeclared constraint delegates to: the nearest base class that implements it.
 **/]
[query public constraintDelegate(classifier : OclAny, constraint : String) : OclAny = if classifier.ecoreClass.oclIsUndefined() then null else firstImplementor(classifier.baseGenClasses, constraint) endif/]

[**
 * Whether a class has no constraints beyond those of the runtime.
 **/]
[query public hasOnlyDefaultConstraints(classifier : OclAny) : Boolean = not classifier.ecoreClass.oclIsUndefined() and classifier.allGenConstraints()->forAll(c | constraintImplementor(classifier, c).oclIsUndefined())/]

[**
 * Whether a package has constraints, which means that it has a validator.
 **/]
[query public hasConstraints(genPackage : GenPackage) : Boolean = genPackage.genClasses->exists(c | c.genConstraints()->notEmpty()) or genPackage.genEnums->exists(e | e.genConstraints()->notEmpty()) or genPackage.genDataTypes->exists(d | d.genConstraints()->notEmpty())/]

[**
 * Whether a package generates a validator.
 **/]
[query public generatesValidator(genPackage : GenPackage) : Boolean = genPackage.hasClassifiers() and genPackage.hasConstraints()/]

[**
 * The classifiers of a package: classes, enumerations and data types.
 **/]
[query public validatedClassifiers(genPackage : GenPackage) : OclAny = genPackage.genClasses->union(genPackage.genEnums)->union(genPackage.genDataTypes)/]

[comment Validation delegates /]

[**
 * The validation delegates that a package names in its annotation.
 **/]
[query public validationDelegates(genPackage : GenPackage) : OclAny = if genPackage.ecorePackage.annotationDetail(ecoreNamespace(), 'validationDelegates').oclIsUndefined() then Sequence{} else genPackage.ecorePackage.annotationDetail(ecoreNamespace(), 'validationDelegates').tokenize(' \t\r\n') endif/]

[**
 * The ecore element of a classifier.
 **/]
[query public ecoreClassifier(classifier : OclAny) : OclAny = if not classifier.ecoreClass.oclIsUndefined() then classifier.ecoreClass else (if not classifier.ecoreEnum.oclIsUndefined() then classifier.ecoreEnum else classifier.ecoreDataType endif) endif/]

[**
 * The validation delegate that has an expression for a constraint of a classifier, if the runtime supports expressions.
 **/]
[query public constraintDelegateSource(classifier : OclAny, constraint : String) : OclAny = if classifier.genModel().runtimeMinorVersion() < 6 then null else classifier.genPackage().validationDelegates()->select(d | not classifier.ecoreClassifier().annotationDetail(d, constraint).oclIsUndefined())->first() endif/]

[**
 * Whether a constraint of a classifier has an expression.
 **/]
[query public hasConstraintExpression(classifier : OclAny, constraint : String) : Boolean = not classifier.constraintDelegateSource(constraint).oclIsUndefined()/]

[**
 * The expression of a constraint, as the text of a string literal that continues over the lines of the expression.
 **/]
[query public constraintExpression(classifier : OclAny, constraint : String) : String = classifier.ecoreClassifier().annotationDetail(classifier.constraintDelegateSource(constraint), constraint).lines()->join('\\n" +' + nonNLS(classifier.genModel(), 1) + '\n      "')/]

[**
 * Whether an invariant operation of a class has an expression body.
 **/]
[query public hasInvariantExpression(genPackage : GenPackage, operation : OclAny) : Boolean = genPackage.genModel().runtimeMinorVersion() >= 6 and genPackage.validationDelegates()->exists(d | not operation.annotationDetail(d, 'body').oclIsUndefined())/]

[**
 * Whether any invariant operation of a package has an expression body.
 **/]
[query public hasInvariantExpressions(genPackage : GenPackage) : Boolean = genPackage.genClasses->exists(c | invariantOperations(c)->exists(o | genPackage.hasInvariantExpression(o)))/]

[comment Packages that supply base constraints /]

[**
 * The packages of base classes that have constraints, apart from the package itself, which the validator delegates to.
 **/]
[query public validatorBasePackages(genPackage : GenPackage) : OclAny = genPackage.genClasses->reject(c | isEObjectClass(c))->collect(c | c.ecoreClass.eAllSuperTypes->collect(b | b.genClassifier())->select(g | not g.oclIsUndefined() and not isEObjectClass(g) and g.genPackage() <> genPackage and g.genConstraints()->notEmpty())->collect(g | g.genPackage()))->flatten()->asOrderedSet()/]

[**
 * The name of the field that holds the validator of a base package.
 **/]
[query public validatorFieldName(genPackage : GenPackage, basePackage : GenPackage) : String = safeName(basePackage.setting('prefix').uncapPrefixedName() + 'Validator')/]

[**
 * The prefix that a call of a constraint takes when another package implements it.
 **/]
[query public delegatePrefix(genPackage : GenPackage, implementor : OclAny) : String = if implementor.oclIsUndefined() or implementor.genPackage() = genPackage then '' else genPackage.validatorFieldName(implementor.genPackage()) + '.' endif/]

[comment Names /]

[query public safeClassifierName(classifier : OclAny) : String = safeName(classifier.name().uncapPrefixedName())/]

[query resultName(classifier : OclAny) : String = if classifier.safeClassifierName() = 'result' then 'theResult' else 'result' endif/]

[query diagnosticsName(classifier : OclAny) : String = if classifier.safeClassifierName() = 'diagnostics' then 'theDiagnostics' else 'diagnostics' endif/]

[query contextName(classifier : OclAny) : String = if classifier.safeClassifierName() = 'context' then 'theContext' else 'context' endif/]

[query comparisonName(classifier : OclAny) : String = if classifier.safeClassifierName() = 'comparison' then 'theComparison' else 'comparison' endif/]

[**
 * The name of the constant that belongs to a constraint of a classifier.
 **/]
[query public constraintConstant(classifier : OclAny, constraint : String) : String = classifier.classifierIDName() + '__' + constraint.upperName()/]

[**
 * Whether a classifier is a data type or enumeration rather than a class.
 **/]
[query public isValueType(classifier : OclAny) : Boolean = classifier.ecoreClass.oclIsUndefined()/]

[**
 * The qualified instance class name of a data type.
 **/]
[query public dataTypeClassName(dataType : OclAny) : String = if dataType.ecoreEnum.oclIsUndefined() then dataType.ecoreDataType.instanceClassName() else dataType.qualifiedEnumName() endif/]

[**
 * Whether a data type maps to a primitive type.
 **/]
[query public isPrimitiveDataType(dataType : OclAny) : Boolean = dataType.ecoreEnum.oclIsUndefined() and isPrimitiveType(dataType.ecoreDataType.instanceClassName())/]

[**
 * Whether a data type maps to the root object type.
 **/]
[query public isObjectDataType(dataType : OclAny) : Boolean = dataType.ecoreEnum.oclIsUndefined() and dataType.ecoreDataType.instanceClassName() = 'java.lang.Object'/]

[**
 * Whether a data type has a type that is compared with compareTo.
 **/]
[query public instanceClassNameOf(dataType : OclAny) : String = dataType.dataTypeClassName()/]

[**
 * The method that gives the length of a value of a data type.
 **/]
[query public lengthAccessor(dataType : OclAny) : String = if dataType.dataTypeClassName().contains('[') then 'length' else (if dataType.dataTypeClassName() = 'java.lang.String' then 'length()' else 'size()' endif) endif/]

[comment Values /]

[**
 * Whether a text has the shape of a floating point number without a point or exponent.
 **/]
[query public isWholeNumber(text : String) : Boolean = not text.contains('.') and not text.contains('e') and not text.contains('E')/]

[**
 * The Java expression that stands for a literal of a data type, for the types that have a literal form.
 * Types without one are written with a call of the factory.
 **/]
[template public staticValue(genPackage : GenPackage, dataType : OclAny, literal : String)][let typeName : String = dataType.dataTypeClassName()][if (typeName = 'java.lang.String')][javaStringLiteral(literal)/][elseif (typeName = 'int' or typeName = 'java.lang.Integer' or typeName = 'boolean' or typeName = 'java.lang.Boolean')][literal/][elseif (typeName = 'long' or typeName = 'java.lang.Long')][literal/]L[elseif (typeName = 'short' or typeName = 'java.lang.Short')](short)[literal/][elseif (typeName = 'byte' or typeName = 'java.lang.Byte')](byte)[literal/][elseif (typeName = 'double' or typeName = 'java.lang.Double')][literal/][if (literal.isWholeNumber())].0[/if][elseif (typeName = 'float' or typeName = 'java.lang.Float')][literal/][if (literal.isWholeNumber())].0[/if]F[elseif (typeName = 'char' or typeName = 'java.lang.Character')]'[literal/]'[elseif (typeName = 'java.math.BigInteger' or typeName = 'java.math.BigDecimal')]new [importedName(typeName)/]("[literal/]")[else][importedName(genPackage.qualifiedFactoryInterfaceName())/].eINSTANCE.createFromString([genPackage.utilityPackageName()/].eINSTANCE.get[dataType.name()/](), [javaStringLiteral(literal)/])[/if][/let][/template]

[**
 * The qualified name of the factory interface of a package.
 **/]
[query public qualifiedFactoryInterfaceName(genPackage : GenPackage) : String = genPackage.reflectionPackageName() + '.' + genPackage.factoryInterfaceName()/]

[**
 * The accessor of the metadata of a classifier in the package interface.
 **/]
[template public classifierAccessor(classifier : OclAny)][let genPackage : GenPackage = classifier.genPackage()][genPackage.utilityPackageName()/][if (genPackage.isOn('literalsInterface'))].Literals.[classifier.classifierIDName()/][else].eINSTANCE.get[classifier.classifierAccessorName()/]()[/if][/let][/template]

[**
 * The text of a pattern list: each pattern as a string literal of the pattern matcher factory.
 **/]
[query public patterns(dataType : OclAny) : OclAny = dataType.facet('pattern').tokenize(' \t\r\n')/]

[**
 * The literals of the enumeration facet of a data type.
 **/]
[query public enumerationLiterals(dataType : OclAny) : OclAny = dataType.facet('enumeration').tokenize(' \t\r\n')/]

[**
 * The literal of the lower bound of a data type and whether it is inclusive.
 **/]
[query public minLiteral(dataType : OclAny) : String = if dataType.hasFacet('minExclusive') then dataType.facet('minExclusive') else dataType.facet('minInclusive') endif/]

[query public isMinInclusive(dataType : OclAny) : Boolean = not dataType.hasFacet('minExclusive')/]

[**
 * The literal of the upper bound of a data type.
 **/]
[query public maxLiteral(dataType : OclAny) : String = if dataType.hasFacet('maxExclusive') then dataType.facet('maxExclusive') else dataType.facet('maxInclusive') endif/]

[query public isMaxInclusive(dataType : OclAny) : Boolean = not dataType.hasFacet('maxExclusive')/]

[**
 * The smallest length that a data type allows: the minimum length, otherwise the fixed length.
 **/]
[query public minLength(dataType : OclAny) : Integer = if dataType.hasFacet('minLength') then dataType.facet('minLength').toInteger() else dataType.facet('length').toInteger() endif/]

[**
 * The greatest length that a data type allows: the maximum length, otherwise the fixed length.
 **/]
[query public maxLength(dataType : OclAny) : Integer = if dataType.hasFacet('maxLength') then dataType.facet('maxLength').toInteger() else dataType.facet('length').toInteger() endif/]

[**
 * The text of the bound of the total digits, a one followed by as many zeros as there are digits.
 **/]
[query public digitBound(digits : Integer) : String = if digits <= 0 then '1' else digitBound(digits - 1) + '0' endif/]

[comment The file /]

[**
 * The complete text of the file that declares the validator of a generator package.
 **/]
[template public validatorClass(genPackage : GenPackage)]
[let genModel : GenModel = genPackage.genModel()]
[let mapType : String = 'Map<Object, Object>']
[collect ('imports', genPackage.qualifiedValidatorClassName())/]
[collect ('imports', Sequence{'java.util.Map', 'org.eclipse.emf.common.util.DiagnosticChain', 'org.eclipse.emf.ecore.EPackage'})/]
[if (genPackage.usesInterfaceWildcard())]
[collect ('imports', genPackage.interfacePackageName() + '.*')/]
[/if]
[header(genPackage)/]
package [genPackage.utilitiesPackageName()/];


[emit ('imports') once][importBlock(items)/][/emit]

