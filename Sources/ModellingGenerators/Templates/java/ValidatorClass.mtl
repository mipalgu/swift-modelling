  public static boolean validate([importedName('org.eclipse.emf.ecore.EClass')/] eClass, [importedName('org.eclipse.emf.ecore.EObject')/] eObject, DiagnosticChain diagnostics, [mapType/] context, [importedName('java.lang.String')/] validationDelegate, [importedName('org.eclipse.emf.ecore.EOperation')/] invariant, [importedName('java.lang.String')/] expression, int severity, [importedName('java.lang.String')/] source, int code)
  {
