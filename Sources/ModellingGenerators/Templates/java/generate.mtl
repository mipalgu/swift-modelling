[comment encoding = UTF-8 /]
[**
 * The main module of the Java template set.
 *
 * It writes the model code of a generator model, one set of files for each generator package.
 * Files that exist already are merged: members whose documentation comment carries the generated tag
 * are regenerated, members marked as not generated are kept, and members without the tag are kept.
 **/]
[module generate('http://www.eclipse.org/emf/2002/GenModel', 'http://swift-modelling.org/typemapping/1.0')/]
[merge ('/**', '*/', '@generated', '@generated NOT', 'braces')/]
[import JavaNames/]
[import JavaImports/]
[import JavaTypes/]
[import EnumClass/]
[import PackageClass/]
[import PackageNames/]
[import Header/]
[import FactoryClass/]
[import JavaUtilities/]
[import SwitchClass/]
[import AdapterFactoryClass/]
[import ValidatorClass/]
[import ProjectFiles/]
[import Class/]
[import ClassQueries/]

[**
 * Writes the model code of every package of a generator model, nested packages included.
 **/]
[template public generate(genModel : GenModel)]
[genModel.generateProjectFiles()/]
[for (genPackage : GenPackage | genModel.allGenPackages())]
[genPackage.generatePackage()/]
[/for]
[/template]

[**
 * Writes the files of one generator package, in the order the Eclipse generator uses.
 **/]
[template public generatePackage(genPackage : GenPackage)]
[genPackage.generatePackageClasses()/]
[if (genPackage.hasClassifiers())]
[if (not genPackage.genModel().isOn('suppressInterfaces'))]
[genPackage.generateFactoryInterfaceFile()/]
[/if]
[genPackage.generateFactoryImplementationFile()/]
[/if]
[genPackage.generateXMLProcessorFile()/]
[if (genPackage.generatesValidator())]
[genPackage.generateValidatorFile()/]
[/if]
[for (genClass : GenClass | genPackage.orderedGenClasses())]
[genClass.generateClassFiles()/]
[/for]
[for (genEnum : GenEnum | genPackage.genEnums)]
[genEnum.generateEnumFile()/]
[/for]
[if (genPackage.generatesAdapterFactory())]
[genPackage.generateSwitchFile()/]
[genPackage.generateAdapterFactoryFile()/]
[/if]
[genPackage.generateResourceFiles()/]
[/template]

[**
 * The number of files that this module writes for the factory of a generator package.
 **/]
[query public factoryFileCount(genPackage : GenPackage) : Integer = if genPackage.hasClassifiers() then (if genPackage.genModel().isOn('suppressInterfaces') then 1 else 2 endif) else 0 endif/]

[**
 * The number of files that this module writes for the validator, switch and adapter factory of a generator package.
 **/]
[query public utilityFileCount(genPackage : GenPackage) : Integer = (if genPackage.generatesAdapterFactory() then 2 else 0 endif) + (if genPackage.generatesValidator() then 1 else 0 endif)/]

[**
 * The number of files that this module writes for the classes of a generator package: the interface of each class
 * that has one and the implementation of each class that is not an interface.
 **/]
[query public classFileCount(genPackage : GenPackage) : Integer = genPackage.genClasses->select(c | not c.isExternalInterface() and not c.genModel().isOn('suppressInterfaces'))->size() + genPackage.genClasses->reject(c | c.isInterface())->size()/]

[**
 * Writes the file of the factory interface of a package.
 **/]
[template public generateFactoryInterfaceFile(genPackage : GenPackage)]
[file (genPackage.reflectionPackageName().packagePath() + '/' + genPackage.factoryInterfaceName() + '.java', false, 'UTF-8')][genPackage.factoryInterface()/][/file]
[/template]

[**
 * Writes the file of the factory implementation of a package.
 **/]
[template public generateFactoryImplementationFile(genPackage : GenPackage)]
[file (genPackage.factoryClassPackageName().packagePath() + '/' + genPackage.factoryClassName() + '.java', false, 'UTF-8')][genPackage.factoryImplementation()/][/file]
[/template]

[**
 * Writes the interface and the implementation of one class, as the Eclipse generator does.
 **/]
[template public generateClassFiles(genClass : GenClass)]
[if (not genClass.isExternalInterface() and not genClass.genModel().isOn('suppressInterfaces'))]
[file (genClass.genPackage().interfacePackageName().packagePath() + '/' + genClass.interfaceName() + '.java', false, 'UTF-8')][genClass.classInterfaceFile()/][/file]
[/if]
[if (not genClass.isInterface())]
[file (genClass.genPackage().classPackageName().packagePath() + '/' + genClass.className() + '.java', false, 'UTF-8')][genClass.classImplementationFile()/][/file]
[/if]
[/template]

[**
 * Writes the file of one enumeration.
 **/]
[template public generateEnumFile(genEnum : GenEnum)]
[file (genEnum.genPackage().interfacePackageName().packagePath() + '/' + genEnum.name() + '.java', false, 'UTF-8')][genEnum.enumClass()/][/file]
[/template]

[**
 * Writes the file of the switch of one generator package.
 **/]
[template public generateSwitchFile(genPackage : GenPackage)]
[file (genPackage.utilitiesPackageName().packagePath() + '/' + genPackage.switchClassName() + '.java', false, 'UTF-8')][genPackage.switchClass()/][/file]
[/template]

[**
 * Writes the file of the validator of one generator package.
 **/]
[template public generateValidatorFile(genPackage : GenPackage)]
[file (genPackage.utilitiesPackageName().packagePath() + '/' + genPackage.validatorClassName() + '.java', false, 'UTF-8')][genPackage.validatorClass()/][/file]
[/template]

[**
 * Writes the file of the adapter factory of one generator package.
 **/]
[template public generateAdapterFactoryFile(genPackage : GenPackage)]
[file (genPackage.utilitiesPackageName().packagePath() + '/' + genPackage.adapterFactoryClassName() + '.java', false, 'UTF-8')][genPackage.adapterFactoryClass()/][/file]
[/template]

[**
 * The number of files that this module writes for a generator model, used to report progress.
 **/]
[template public fileCount(genModel : GenModel)]
[file ('count')]
[genModel.allGenPackages()->collect(p | p.genEnums->size() + p.packageFileCount() + p.factoryFileCount() + p.utilityFileCount() + p.classFileCount())->sum() + genModel.projectFileCount()/]
[/file]
[/template]

[**
 * Writes the package interface and the package implementation of a generator package that has classifiers.
 **/]
[template public generatePackageClasses(genPackage : GenPackage)]
[if (genPackage.hasClassifiers())]
[if (genPackage.isLoadingInitialization())]
[file (genPackage.classPackageName().packagePath() + '/' + genPackage.serializedPackageFilename(), false, 'UTF-8')][if (genPackage.genModel().isOn('suppressGenModelAnnotations'))][genPackage.serialisedEcore(copyrightSource())/][else][genPackage.serialisedEcore()/][/if][/file]
[/if]
[if (not genPackage.genModel().isOn('suppressEMFMetaData') and not genPackage.genModel().isOn('suppressInterfaces'))]
[file (genPackage.reflectionPackageName().packagePath() + '/' + genPackage.packageInterfaceName() + '.java', false, 'UTF-8')][genPackage.packageInterface()/][/file]
[/if]
[file ((if genPackage.genModel().isOn('suppressInterfaces') then genPackage.reflectionPackageName() else genPackage.classPackageName() endif).packagePath() + '/' + genPackage.packageClassName() + '.java', false, 'UTF-8')][genPackage.packageImplementation()/][/file]
[/if]
[/template]
