[comment encoding = UTF-8 /]
[**
 * The Java file of the XML processor of a generator package.
 *
 * The processor extends the runtime's helper for serialising and deserialising XML documents. It
 * registers the resource factory of the package for the star and xml file extensions.
 *
 * This template writes the form for compliance level 5.0 and higher.
 **/]
[module XMLProcessorClass('http://www.eclipse.org/emf/2002/GenModel', 'http://swift-modelling.org/typemapping/1.0')/]
[import JavaNames/]
[import JavaImports/]
[import Header/]
[import JavaDocumentation/]
[import JavaResources/]

[**
 * The complete text of the file that declares the XML processor of a generator package.
 **/]
[template public xmlProcessorClass(genPackage : GenPackage)]
[let genModel : GenModel = genPackage.genModel()]
[collect ('imports', genPackage.qualifiedXMLProcessorClassName())/]
[collect ('imports', 'java.util.Map')/]
[header(genPackage)/]
package [genPackage.utilitiesPackageName()/];


[emit ('imports') once][importBlock(items)/][/emit]

/**
 * This class contains helper methods to serialize and deserialize XML documents
 * <!-- begin-user-doc -->
 * <!-- end-user-doc -->
[for (line | genPackage.packageTagLines())]
 * [line/]
[/for]
 * @generated
 */
[if (genModel.useGenerics() and genPackage.hasAPIDeprecatedTag())]
@Deprecated
[/if]
public class [genPackage.xmlProcessorClassName()/] extends [importedName('org.eclipse.emf.ecore.xmi.util.XMLProcessor')/]
{
[if (genModel.hasCopyrightField())]
  /**
   * <!-- begin-user-doc -->
   * <!-- end-user-doc -->
   * @generated
   */
  public static final [importedName('java.lang.String')/] copyright = [genModel.copyrightFieldLiteral()/];[nonNLS(genModel, 1)/]

[/if]

  /**
   * Public constructor to instantiate the helper.
   * <!-- begin-user-doc -->
   * <!-- end-user-doc -->
   * @generated
   */
  public [genPackage.xmlProcessorClassName()/]()
  {
[if (genPackage.hasExtendedMetaData() and not genPackage.hasTargetNamespace())]
    super(new [importedName('org.eclipse.emf.ecore.impl.EPackageRegistryImpl')/]([importedName('org.eclipse.emf.ecore.EPackage')/].Registry.INSTANCE));
    extendedMetaData.putPackage(null, [importedName(genPackage.qualifiedPackageInterfaceName())/].eINSTANCE);
[else]
    super(([importedName('org.eclipse.emf.ecore.EPackage')/].Registry.INSTANCE));
    [importedName(genPackage.qualifiedPackageInterfaceName())/].eINSTANCE.eClass();
[/if]
  }
  
  /**
   * Register for "*" and "xml" file extensions the [genPackage.resourceFactoryClassName()/] factory.
   * <!-- begin-user-doc -->
   * <!-- end-user-doc -->
   * @generated
   */
[if (genModel.useClassOverrideAnnotation())]
  @Override
[/if]
  protected Map<[importedName('java.lang.String')/], [importedName('org.eclipse.emf.ecore.resource.Resource')/].Factory> getRegistrations()
  {
    if (registrations == null)
    {
      super.getRegistrations();
      registrations.put(XML_EXTENSION, new [genPackage.resourceFactoryClassName()/]());
      registrations.put(STAR_EXTENSION, new [genPackage.resourceFactoryClassName()/]());
    }
    return registrations;
  }

} //[genPackage.xmlProcessorClassName()/]
[/let]
[/template]
