[comment encoding = UTF-8 /]
[**
 * The Event-B context and machine of a model.
 *
 * The context extends the context of the package of the model. Every object of the model is a constant, named after
 * its class and its position in the model, and so is every distinct string; the axioms state that the objects are all
 * the objects there are and that the strings differ. The machine sees this context and has the variables and
 * invariants of the machine of the package; its initialisation assigns the population of every class and the values
 * of every feature in the model, so that its invariant proof obligations hold exactly if the model satisfies the
 * invariants.
 **/]
[module EventBModel('http://www.eclipse.org/emf/2002/Ecore')/]
[import verification::VerificationQueries/]
[import EventBNames/]
[import EventBMetamodel/]

[**
 * The complete text of the context of a model.
 **/]
[template public modelContext(p : EPackage, objects : Sequence(EObject), strings : Sequence(String), model : String)]
/*
 * Event-B context of a model of the Ecore package [p.name/] ([p.nsURI/]), in CamilleX notation.
 *
 * Rodin compiles this file into the context [instanceContextName(model)/] once it is in an Event-B project with the
 * CamilleX plug-in installed, beside the files of the context [p.contextName()/] and the machine [p.machineName()/].
 *
 * Every object of the model is a constant, named after its class and its position in the model, and every distinct
 * string of the model is a constant whose comment shows the text. The axioms state that these are all the objects
 * there are and that the strings differ. The populations of the classes and the values of the features are variables
 * of the machine [instanceMachineName(model)/], which assigns them.
 */
context [instanceContextName(model)/]
extends [p.contextName()/]
constants
[for (o : EObject | objects)]
  [atom(objects, o)/]
[/for]
[for (s : String | strings)]
  [s.verificationString(target())/] [stringId(strings, s)/]
[/for]
axioms
  @objects: partition([objectSet()/], [objects->collect(o | '{' + atom(objects, o) + '}')->sep(', ')/])
[if (strings->notEmpty())]
  @strings_type: [extension(strings->collect(s | stringId(strings, s)))/] ⊆ [stringSet()/]
  @strings_distinct: partition([extension(strings->collect(s | stringId(strings, s)))/], [strings->collect(s | '{' + stringId(strings, s) + '}')->sep(', ')/])
[/if]
end
[/template]

[**
 * The complete text of the machine of a model.
 **/]
[template public modelMachine(p : EPackage, objects : Sequence(EObject), strings : Sequence(String), model : String)]
/*
 * Event-B machine of a model of the Ecore package [p.name/] ([p.nsURI/]), in CamilleX notation.
 *
 * Rodin compiles this file into the machine [instanceMachineName(model)/] once it is in an Event-B project with the
 * CamilleX plug-in installed, beside the files of the context [instanceContextName(model)/] and of the package.
 *
 * The machine has the variables and invariants of [p.machineName()/], and its INITIALISATION assigns the population
 * of every class and the values of every feature in the model. Each invariant proof obligation INITIALISATION/<label>/INV therefore holds exactly if the model satisfies
 * the invariant with that label: together they state that the model conforms to the multiplicities, opposite
 * references, containment and translated invariants of the metamodel. Values of uninterpreted data types are not
 * fixed: the INITIALISATION fixes only which objects have such values.
 */
machine [instanceMachineName(model)/]
sees [instanceContextName(model)/]
[p.machineBody()/]
events
  event INITIALISATION
[if (p.variableIds()->notEmpty())]
  then
[for (c : EClass | p.classes())]
    @[id(c.name)/]_init: [id(c.name)/] ≔ [extension(p.population(objects, c))/]
[/for]
[for (c : EClass | p.classes())]
[for (f : EStructuralFeature | c.variableFeatures())]
    [p.initialAction(objects, strings, c, f)/]
[/for]
[/for]
[/if]
  end
end
[/template]

[**
 * The action of an initialisation that assigns the values of a feature in a model. Values of an uninterpreted data
 * type are not known: the action then chooses any values that satisfy the type and bounds of the feature, for exactly
 * the objects that have a value.
 **/]
[query public initialAction(p : EPackage, objects : Sequence(EObject), strings : Sequence(String), c : EClass, f : EStructuralFeature) : String = if f.valueKind() = 'uninterpreted' and p.valuedObjects(objects, c, f)->notEmpty() then uninterpretedComment(f) + ' @' + c.featureId(f) + '_init: ' + c.featureId(f) + ' :∣ ' + p.modelFeaturePredicates(objects, c, f)->collect(s | conjunct(s))->sep(' ∧ ') + ' ∧ dom(' + c.featureRef(f, true) + ') = ' + extension(p.valuedObjects(objects, c, f)) else '@' + c.featureId(f) + '_init: ' + c.featureId(f) + ' ≔ ' + p.valuePairs(objects, strings, c, f) endif/]

[**
 * The objects of a model that are instances of a class, as constants.
 **/]
[query public population(p : EPackage, objects : Sequence(EObject), c : EClass) : Sequence(String) = objects->select(o | p.classOf(o).conformsTo(c))->collect(o | atom(objects, o))/]

[**
 * The type and bounds of a feature in the before-after predicate of the initialisation of a model, over the population
 * of its class in the model, since an initialisation cannot read the populations that it assigns.
 **/]
[query public modelFeaturePredicates(p : EPackage, objects : Sequence(EObject), c : EClass, f : EStructuralFeature) : Sequence(String) = let domain : String = extension(p.population(objects, c)) in if f.hasCardinalityBounds() then Sequence{c.typingOver(f, domain, true), c.boundsOver(f, domain, true)} else Sequence{c.typingOver(f, domain, true)} endif/]

[**
 * The CamilleX comment of a feature whose values the export does not interpret.
 **/]
[query public uninterpretedComment(f : EStructuralFeature) : String = ('values of ' + f.eType.name + ' are uninterpreted: only the objects that have a value are fixed').verificationString(target())/]

[**
 * The constant of an object: the name of its class followed by its position in the model.
 **/]
[query public atom(objects : Sequence(EObject), o : EObject) : String = id(o.eClass().name + objects->indexOf(o).toString())/]

[**
 * The distinct strings of the exported features of the objects of a model, in the order of their first use.
 **/]
[query public modelStrings(p : EPackage, objects : Sequence(EObject)) : Sequence(String) = objects->collect(o | p.classOf(o).allExportedFeatures()->select(f | f.valueKind() = 'string')->collect(f | o.valuesOf(f)))->flatten()->collect(v | v.toString())->asOrderedSet()->asSequence()/]

[**
 * The constant of a string of a model.
 **/]
[query public stringId(strings : Sequence(String), s : String) : String = stringSet() + '_' + strings->indexOf(s).toString()/]

[**
 * The objects of a model that are instances of a class and have a value of one of its features.
 **/]
[query public valuedObjects(p : EPackage, objects : Sequence(EObject), c : EClass, f : EStructuralFeature) : Sequence(String) = objects->select(o | p.classOf(o).conformsTo(c) and o.valuesOf(f)->notEmpty())->collect(o | atom(objects, o))/]

[**
 * The value of a feature in a model as a relation in extension, such as '{Branch2 ↦ 1, Branch3 ↦ 2}'.
 **/]
[query public valuePairs(p : EPackage, objects : Sequence(EObject), strings : Sequence(String), c : EClass, f : EStructuralFeature) : String = extension(objects->select(o | p.classOf(o).conformsTo(c))->collect(o | o.valuesOf(f)->collect(v | atom(objects, o) + ' ↦ ' + p.valueText(objects, strings, f, v)))->flatten())/]

[**
 * The Event-B text of a value of a feature.
 **/]
[query public valueText(p : EPackage, objects : Sequence(EObject), strings : Sequence(String), f : EStructuralFeature, v : OclAny) : String = if f.valueKind() = 'object' then atom(objects, v) else if f.valueKind() = 'integer' then (if v < 0 then '(−' + (0 - v).toString() + ')' else v.toString() endif) else if f.valueKind() = 'boolean' then (if v then 'TRUE' else 'FALSE' endif) else if f.valueKind() = 'string' then stringId(strings, v.toString()) else literalId(f.eType, f.eType.eLiterals->select(l | l.name = v.toString() or l.literal = v.toString())->first().name) endif endif endif endif/]
