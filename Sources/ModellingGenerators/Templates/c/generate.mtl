[comment encoding = UTF-8 /]
[**
 * The main module of the C template set.
 *
 * It writes the model code of a generator model: the support header that every package header builds on, and a header
 * and a source file for every package, in a directory named after the package. C files that exist already are merged:
 * members whose comment carries the generated tag are regenerated, members marked as not generated are kept, and
 * members without a tag are kept.
 **/]
[module generate('http://www.eclipse.org/emf/2002/GenModel', 'http://swift-modelling.org/typemapping/1.0')/]
[merge ('//', '', '@generated', '@generated NOT', 'braces', 'terminators=\n;', 'quotes="', 'files=*.c *.h')/]
[import CNames/]
[import CIncludes/]
[import CTypes/]
[import EObjectHeader/]
[import PackageHeader/]
[import PackageSource/]

[**
 * Writes the support header and the files of every package of a generator model, nested packages included.
 **/]
[template public generate(genModel : GenModel)]
[file (supportHeaderName(), false, 'UTF-8')][supportHeader()/][/file]
[for (genPackage : GenPackage | genModel.allGenPackages())]
[genPackage.generatePackage()/]
[/for]
[/template]

[**
 * Writes the header and the source file of one generator package.
 **/]
[template public generatePackage(genPackage : GenPackage)]
[if (genPackage.hasClassifiers())]
[file (genPackage.headerPath(), false, 'UTF-8')][genPackage.packageHeader()/][/file]
[file (genPackage.sourcePath(), false, 'UTF-8')][genPackage.packageSource()/][/file]
[/if]
[/template]

[**
 * The number of files that this module writes for a generator model, used to report progress.
 **/]
[template public fileCount(genModel : GenModel)]
[file ('count')]
[1 + genModel.allGenPackages()->collect(p | if p.hasClassifiers() then 2 else 0 endif)->sum()/]
[/file]
[/template]
