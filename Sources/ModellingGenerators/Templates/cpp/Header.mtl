[comment encoding = UTF-8 /]
[**
 * The comment that opens every generated C++ header: the name of the file and the copyright text, if there is one.
 **/]
[module Header('http://www.eclipse.org/emf/2002/GenModel', 'http://swift-modelling.org/typemapping/1.0')/]
[import CppNames/]

[**
 * The source of the annotation that carries copyright text in a model.
 **/]
[query public copyrightSource() : String = 'http://www.eclipse.org/emf/2002/GenModel'/]

[**
 * The copyright text that applies to a generator element: the copyright annotation of the element
 * or of the nearest container that has one, otherwise the copyright text of the generator model.
 **/]
[query public copyrightText(element : OclAny) : OclAny = if element.oclIsUndefined() then null else (if element.oclIsKindOf(GenModel) then (if isBlank(element.setting('copyrightText')) then null else element.setting('copyrightText') endif) else (if element.annotationDetail(copyrightSource(), 'copyright').oclIsUndefined() then copyrightText(element.genContainer()) else element.annotationDetail(copyrightSource(), 'copyright') endif) endif) endif/]

[**
 * Writes the comment that opens a file: its name, with the extension of headers, and the copyright text, if there is
 * one.
 **/]
[template public header(element : OclAny, fileName : String)]
//
//  [headerFileName(fileName)/]
[if (not copyrightText(element).oclIsUndefined())]
//
//  [copyrightText(element).indentLines('//  ')/]
[/if]
//
[/template]
