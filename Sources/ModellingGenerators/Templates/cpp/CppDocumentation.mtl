[comment encoding = UTF-8 /]
[**
 * Documentation comments, literals and tags in generated C++ code.
 *
 * The queries here write the pieces that surround generated declarations: documentation comments taken from
 * the documentation of the model, the tag that marks a member as generated, and string literals with their escapes.
 **/]
[module CppDocumentation('http://www.eclipse.org/emf/2002/GenModel', 'http://swift-modelling.org/typemapping/1.0')/]
[import CppNames/]

[comment Literals and escapes /]

[**
 * Whether a text consists only of printable ASCII characters other than backslash and quotes.
 **/]
[query public isPlainText(text : String) : Boolean = text.matches('^[ -!#-\\[\\]-~]*$')/]

[**
 * Escapes one character code for a string literal: the usual escapes for quotes, backslash and line breaks, and
 * a three digit octal escape for other control characters. Other characters are written as they are.
 *
 * The code is a UTF-16 code unit of the text; a unit that needs no escape is written as the character it stands for.
 **/]
[query public escapeCode(code : Integer) : String = if code = 9 then '\\t' else (if code = 10 then '\\n' else (if code = 13 then '\\r' else (if code = 34 then '\\"' else (if code = 92 then '\\\\' else (if code < 32 or code = 127 then '\\' + code.toOctalString(3) else code.fromCharacterCode() endif) endif) endif) endif) endif) endif/]

[**
 * A string literal for a text; a missing text becomes an empty literal.
 *
 * The text between the quotes is the text itself when it is plain, otherwise it is written character by character with
 * escapes where they are needed.
 **/]
[query public cppStringLiteral(text : OclAny) : String = if text.oclIsUndefined() then '""' else '"' + (if text.isPlainText() then text else text.characterCodes()->collect(c | escapeCode(c))->join('') endif) + '"' endif/]

[comment Documentation comments /]

[**
 * A text as documentation comment lines. The template writer indents every line but the first like the line that
 * the first one stands on.
 *
 * Every line starts with three slashes. A blank line becomes a line with the slashes alone, which separates the
 * paragraphs.
 **/]
[query public docComment(text : String) : String = text.lines()->collect(l | if l.trim().size() = 0 then '///' else '/// ' + l.continuationSafe() endif)->join('\n')/]

[**
 * A line of documentation that cannot continue the comment onto the next line: a trailing backslash is followed by a
 * space, because a backslash at the end of a line comment joins the next line to it.
 **/]
[query public continuationSafe(line : String) : String = if line.endsWith('\\') then line + ' ' else line endif/]

[**
 * A text as documentation comment lines whose first paragraph is the brief description. Text that starts with a command
 * of its own is left as it is.
 *
 * The first paragraph is the brief description that documentation tools show in listings; the paragraphs after it stay
 * below.
 **/]
[query public briefComment(text : String) : String = if text.trim().startsWith('@') then text.trim().docComment() else '/// @brief ' + text.trim().docComment().substring(5) endif/]

[**
 * The documentation comment of an element: its model documentation, otherwise the fallback text. The first
 * paragraph becomes the brief description.
 *
 * A fallback is the text the generator writes for an element whose model has no documentation, so that every generated
 * member is documented.
 **/]
[query public documentationText(element : OclAny, fallback : String) : String = if element.hasDocumentation() then element.documentation().briefComment() else fallback.briefComment() endif/]

[**
 * The tag that tells the generator to regenerate the member that follows. It stands in a comment of its own, so
 * that it does not become part of the documentation.
 **/]
[query public generatedTag() : String = '// @generated'/]
