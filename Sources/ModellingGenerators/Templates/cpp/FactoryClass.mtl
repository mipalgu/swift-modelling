[comment encoding = UTF-8 /]
[**
 * The header of the factory of a generator package.
 *
 * The factory has a function that creates an object for every class that has instances, and a function that
 * creates an object for the name of a class.
 **/]
[module FactoryClass('http://www.eclipse.org/emf/2002/GenModel', 'http://swift-modelling.org/typemapping/1.0')/]
[import CppNames/]
[import CppIncludes/]
[import CppTypes/]
[import CppDocumentation/]
[import Header/]
[import ClassQueries/]

[**
 * The classes of a package that have instances.
 **/]
[query public instantiableClasses(genPackage : GenPackage) : OclAny = genPackage.genClasses->select(c | c.isInstantiable())/]

[**
 * The name of the function of a factory that creates the objects of a class.
 *
 * The name is the word create followed by the name of the class with a capital first letter.
 **/]
[query public creationFunction(genClass : GenClass) : String = 'create' + genClass.name().toUpperFirst()/]

[**
 * The complete text of the header that declares the factory of a generator package.
 *
 * The factory is a class with one shared instance. It includes the headers of all classes that have instances, because
 * it constructs them.
 **/]
[template public factoryFile(genPackage : GenPackage)]
[collect ('includes', Sequence{supportInclude(), standardInclude(memoryHeader()), standardInclude(textViewHeader())})/]
[for (genClass : GenClass | genPackage.instantiableClasses())]
[collect ('includes', projectInclude(genClass.classifierHeader()))/]
[/for]
#pragma once

[header(genPackage, genPackage.factoryFileName())/]

[emit ('includes') once][includeBlock(items)/][/emit]
[generatedTag()/]
namespace [genPackage.namespacePath()/] {

/// @brief The factory of the [genPackage.name()/] package.
///
/// The factory creates the objects of the classes of the package that have instances.
[generatedTag()/]
class [genPackage.factoryTypeName()/] final {
public:
    /// @brief The shared factory of the package.
    /// @return The only instance.
    [generatedTag()/]
    static const [genPackage.factoryTypeName()/] &instance() {
        static const [genPackage.factoryTypeName()/] factory;
        return factory;
    }
[for (genClass : GenClass | genPackage.instantiableClasses())]

    /// @brief Creates a new [genClass.name()/] object.
    /// @return An object with all features at their defaults.
    [generatedTag()/]
    [sharedType(genClass.className())/] [genClass.creationFunction()/]() const { return [makeSharedFunction()/]<[genClass.className()/]>(); }
[/for]

    /// @brief Creates an object for the name of a class of the package.
    /// @param className The name of the class in the model.
    /// @return A new object, or a null pointer if the package has no class with instances of that name.
    [generatedTag()/]
    [sharedType(rootObjectType())/] create(['['/]['['/]maybe_unused[']'/][']'/] [textViewType()/] className) const {
[for (genClass : GenClass | genPackage.instantiableClasses())]
        if (className == [cppStringLiteral(genClass.name())/]) return [genClass.creationFunction()/]();
[/for]
        return nullptr;
    }
};

}
[/template]
