[comment encoding = UTF-8 /]
[**
 * The Swift file of a generator data type.
 *
 * A data type that a model defines becomes a type alias of the Swift type that its instance class maps to, so that
 * the properties of the model read with the names of the model.
 **/]
[module DataTypeFile('http://www.eclipse.org/emf/2002/GenModel', 'http://swift-modelling.org/typemapping/1.0')/]
[import SwiftNames/]
[import SwiftImports/]
[import SwiftTypes/]
[import SwiftDocumentation/]
[import Header/]

[**
 * The complete text of the file that declares a type alias for a generator data type.
 **/]
[template public dataTypeFile(genDataType : GenDataType)]
[collect ('imports', Sequence{valueModule(), foundationModule()})/]
[if (not genDataType.ecoreDataType.dataTypeMapping().oclIsUndefined() and not genDataType.ecoreDataType.dataTypeMapping().module.isBlank())]
[collect ('imports', genDataType.ecoreDataType.dataTypeMapping().module)/]
[/if]
[header(genDataType, genDataType.classifierFileName())/]

[emit ('imports') once][importBlock(items)/][/emit]
[documentationText(genDataType, 'The ' + genDataType.name() + ' data type.')/]
[generatedTag()/]
public typealias [typeIdentifier(genDataType.name())/] = [genDataType.aliasedTypeName()/]
[/template]
