[collect ('imports', lockModule())/]
[for (genFeature : GenFeature | genClass.implementedFeatures())]
[genFeature.collectFeatureModule()/]
[/for]
[/if]
[header(genClass, genClass.classifierFileName())/]

[emit ('imports') once][importBlock(items)/][/emit]
[if (genClass.isProtocol())]
[genClass.protocolDeclaration()/]
[/if]
[if (genClass.isProtocol() and genClass.isInstantiable())]

[/if]
[if (genClass.isInstantiable())]
[genClass.finalClassDeclaration()/]
[/if]
[/template]

