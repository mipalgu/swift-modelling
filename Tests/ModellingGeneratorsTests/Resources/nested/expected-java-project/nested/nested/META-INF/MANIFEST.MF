Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: nested;singleton:=true
Automatic-Module-Name: nested
Bundle-Version: 1.0.0.qualifier
Bundle-ClassPath: .
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-RequiredExecutionEnvironment: JavaSE-17
Export-Package: org.example.company.company,
 org.example.company.company.impl,
 org.example.company.company.people,
 org.example.company.company.people.impl,
 org.example.company.company.people.util,
 org.example.company.company.projects,
 org.example.company.company.projects.archive,
 org.example.company.company.projects.archive.impl,
 org.example.company.company.projects.archive.util,
 org.example.company.company.projects.impl,
 org.example.company.company.projects.util,
 org.example.company.company.util
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.emf.ecore;visibility:=reexport,
 org.eclipse.emf.ecore.xmi;visibility:=reexport
Bundle-ActivationPolicy: lazy
