<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="catalogue" nsURI="http://www.example.org/catalogue"
    nsPrefix="catalogue">
  <eClassifiers xsi:type="ecore:EClass" name="Catalogue">
    <eStructuralFeatures xsi:type="ecore:EReference" name="items" upperBound="-1"
        eType="#//Item" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="makers" upperBound="-1"
        eType="#//Maker" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Item" eSuperTypes="catalogue-base.ecore#//Named">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="#//Kind"
        defaultValueLiteral="tool"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="maker" eType="#//Maker"
        eOpposite="#//Maker/items"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Maker" eSuperTypes="catalogue-base.ecore#//Named">
    <eStructuralFeatures xsi:type="ecore:EReference" name="items" upperBound="-1"
        eType="#//Item" eOpposite="#//Item/maker"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Gadget" eSuperTypes="#//Item"/>
  <eClassifiers xsi:type="ecore:EEnum" name="Kind">
    <eLiterals name="tool"/>
    <eLiterals name="toy" value="1"/>
    <eLiterals name="book" value="2" literal="Book"/>
  </eClassifiers>
</ecore:EPackage>
